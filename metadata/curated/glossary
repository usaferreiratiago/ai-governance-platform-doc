# =====================================================================
# Business Glossary - Curated Semantic Model
# =====================================================================
# This file contains the approved business terms for the semantic model.
# Any changes must be reviewed and approved by the Data Governance Team.
# =====================================================================

version: 1.0.0
last_updated: 2026-07-30
domain: Retail & E-commerce
status: Approved

terms:
  # -----------------------------------------------------------------
  # Financial Measures
  # -----------------------------------------------------------------
  - business_term: Net Revenue
    description: Revenue after discounts, returns, and allowances.
    synonyms:
      - revenue
      - sales
      - turnover
      - net sales
    category: Financial
    table: financials
    field: net_revenue
    data_type: decimal(18,2)
    certified: true
    owner: Finance Team
    usage_guidance: |
      Use this measure for all revenue-related questions.
      Always apply Date filter when querying.
    examples:
      - "Net Revenue for Q2 2026"
      - "Net Revenue by Product Category"
    tags:
      - core_metric
      - revenue
      - financial

  - business_term: Gross Margin %
    description: Gross profit divided by net revenue, expressed as a percentage.
    synonyms:
      - margin
      - gross margin
      - profitability
      - gross profit %
    category: Financial
    table: financials
    field: gross_margin_percent
    data_type: decimal(5,2)
    certified: true
    owner: Finance Team
    usage_guidance: |
      This is a derived measure calculated as:
      (Net Revenue - Cost of Goods Sold) / Net Revenue * 100
      Always apply Date filter when querying.
    examples:
      - "Gross Margin % for July 2026"
      - "Gross Margin % by Product Category"
    tags:
      - core_metric
      - margin
      - profitability

  # -----------------------------------------------------------------
  # Commercial Measures
  # -----------------------------------------------------------------
  - business_term: Average Unit Price
    description: Average selling price per unit sold.
    synonyms:
      - unit price
      - average price
      - average receipt
      - avg price per unit
    category: Commercial
    table: sales
    field: avg_unit_price
    data_type: decimal(18,2)
    certified: true
    owner: Commercial Team
    usage_guidance: |
      Calculated as Total Sales Revenue / Total Units Sold.
      For accurate results, ensure filters for Date and Product Category are applied.
    examples:
      - "Average Unit Price for Product A"
      - "Average Unit Price by Region"
    tags:
      - commercial
      - pricing

  # -----------------------------------------------------------------
  # Inventory Measures
  # -----------------------------------------------------------------
  - business_term: Inventory Value
    description: Monetary value of inventory on hand, calculated at standard cost.
    synonyms:
      - stock value
      - inventory
      - stock
      - inventory amount
    category: Inventory
    table: inventory
    field: inventory_value
    data_type: decimal(18,2)
    certified: true
    owner: Supply Chain Team
    usage_guidance: |
      Always apply filters for Date and Warehouse to ensure accurate valuation.
      Values are based on standard cost, not market value.
    examples:
      - "Inventory Value as of June 2026"
      - "Inventory Value by Warehouse"
    mandatory_filters:
      - Date
      - Warehouse
    tags:
      - inventory
      - supply_chain
      - stock

  # -----------------------------------------------------------------
  # Operational Measures
  # -----------------------------------------------------------------
  - business_term: Return Rate
    description: Percentage of sold units that were returned by customers.
    synonyms:
      - returns
      - refund rate
      - return percentage
      - return ratio
    category: Operational
    table: returns
    field: return_rate
    data_type: decimal(5,2)
    certified: true
    owner: Operations Team
    usage_guidance: |
      Calculated as (Returned Units / Sold Units) * 100.
      For accurate results, apply Date and Product Category filters.
    examples:
      - "Return Rate for Q2 2026"
      - "Return Rate by Product Category"
    mandatory_filters:
      - Date
    tags:
      - operational
      - quality
      - returns

  # -----------------------------------------------------------------
  # Additional Terms (Optional)
  # -----------------------------------------------------------------
  - business_term: Sales Total
    description: Total gross sales revenue before discounts and returns.
    synonyms:
      - gross sales
      - total sales
      - gross revenue
    category: Commercial
    table: sales
    field: sales_total
    data_type: decimal(18,2)
    certified: true
    owner: Commercial Team
    usage_guidance: |
      This measure includes all sales transactions before deductions.
      For net revenue, use the Net Revenue measure instead.
    examples:
      - "Sales Total for Q2 2026"
      - "Sales Total by Product Category"
    tags:
      - commercial
      - sales

# =====================================================================
# Metadata Quality Standards
# =====================================================================
metadata_standards:
  - field: business_term
    description: Official name of the business term
    required: true
    unique: true
  
  - field: description
    description: Clear, concise definition of the term
    required: true
  
  - field: category
    description: Business domain (Financial, Commercial, Inventory, Operational, CRM)
    required: true
    allowed_values:
      - Financial
      - Commercial
      - Inventory
      - Operational
      - CRM
  
  - field: table
    description: Source table in the semantic model
    required: true
  
  - field: field
    description: Field name in the source table
    required: true
  
  - field: certified
    description: Indicates if the measure is officially approved
    required: true
    type: boolean
  
  - field: mandatory_filters
    description: Filters that must be applied before querying this measure
    required: false
    type: list

# =====================================================================
# Validation Rules
# =====================================================================
validation_rules:
  - rule: No orphaned terms
    description: Each term must reference an existing table and field.
    check: |
      For each term, verify that the table and field exist in the semantic model.
  
  - rule: Consistent naming
    description: Business terms must follow the approved naming convention.
    check: |
      Terms should be in Title Case. Avoid abbreviations unless defined in the glossary.
  
  - rule: Mandatory filters
    description: Terms with mandatory filters must clearly define them.
    check: |
      If mandatory_filters is present, ensure it's a non-empty list of valid filter names.
  
  - rule: Synonyms uniqueness
    description: No two terms should share the same primary synonym.
    check: |
      The business_term field must be unique across all terms. Synonyms can overlap.

