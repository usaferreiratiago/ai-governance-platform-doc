      "category": "Commercial",
      "certified": true,
      "certification_date": "2026-07-01"
    },
    {
      "name": "Inventory Value",
      "description": "Total inventory value available in stock",
      "table": "Product",
      "category": "Inventory",
      "certified": true,
      "certification_date": "2026-07-01"
    },
    {
      "name": "Return Rate",
