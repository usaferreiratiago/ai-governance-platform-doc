    {
      "name": "Inventory",
      "description": "Inventory data including stock levels and warehouse information",
      "type": "Fact",
      "row_count_estimate": 500000,
      "refresh_frequency": "Daily"
    }
  ],
  
  "certified_measures": [
    {
      "name": "Net Revenue",
      "description": "Total net sales amount after discounts and returns",
