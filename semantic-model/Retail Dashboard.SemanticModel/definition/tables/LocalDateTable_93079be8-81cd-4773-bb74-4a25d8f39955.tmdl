	partition 'Local Date Table - Load Execution' = calculated
		mode: import
		source = Calendar(Date(Year(MIN('LOG_ESECUZIONI_DWH'[MAX_END_DATE])), 1, 1), Date(Year(MAX('LOG_ESECUZIONI_DWH'[MAX_END_DATE])), 12, 31))

		annotation Description = "Auto-generated local date table partition. Date range is dynamically calculated from the LOG_ESECUZIONI_DWH table's MAX_END_DATE column, spanning full years from the minimum to maximum load execution year. This ensures the date table covers all data load execution dates referenced in the model. Used for tracking data refresh timelines, load execution history, and data freshness analysis. Proposed – pending Loro Piana validation on data source and date range logic."

	annotation __PBI_LocalDateTable = true

	annotation Description = "Power BI auto-generated local date table providing a continuous date range for data load execution time intelligence calculations. This hidden table serves as the foundation for date-based relationships and time intelligence functions based on the MAX_END_DATE field from the LOG_ESECUZIONI_DWH table. Contains standard date attributes including Year, Quarter, Month, and Day, with a default 'Date Hierarchy' for drill-down analysis. Date range is dynamically derived from the 'LOG_ESECUZIONI_DWH' table's MAX_END_DATE column (full years only). Used for tracking data refresh timelines, load execution history, and data freshness analysis. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Local Date Table, Date Dimension, Time Dimension, Calendar Table, Date Hierarchy, Load Execution Date Table, Data Refresh Date Table"

	annotation DisplayFolder = "System Tables"

	annotation RefreshPolicy = "Dynamically generated based on LOG_ESECUZIONI_DWH table data range. No manual refresh required. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana BI Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "Date: 2024-01-01, Year: 2024, Quarter: Qtr 1, Month: January, Day: 1"

	annotation 'Common Questions' = "What is the data load execution date range? How do I use the date hierarchy for load tracking? How do I filter by load year, quarter, or month? What is the load execution date table used for?"

	annotation 'Related Objects' = "LOG_ESECUZIONI_DWH, SCONTRINI, DateTableTemplate"

	annotation __PBI_NavigationStepName = Navigation

