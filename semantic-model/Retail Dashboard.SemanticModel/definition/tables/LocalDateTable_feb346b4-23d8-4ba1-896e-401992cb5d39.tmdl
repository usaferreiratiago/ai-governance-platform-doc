	partition 'Local Date Table - Last Year Date' = calculated
		mode: import
		source = Calendar(Date(Year(MIN('CALENDARIO'[Date LY])), 1, 1), Date(Year(MAX('CALENDARIO'[Date LY])), 12, 31))

		annotation Description = "Auto-generated local date table partition. Date range is dynamically calculated from the CALENDARIO table's Date LY (last year date) column, spanning full years from the minimum to maximum LY year. This ensures the date table covers all last year dates referenced in the model. Used for year-over-year comparisons, same-period-last-year analysis, and LY reference calculations. Proposed – pending Loro Piana validation on data source and date range logic."

	annotation __PBI_LocalDateTable = true

	annotation Description = "Power BI auto-generated local date table providing a continuous date range for last year (LY) date-based time intelligence calculations. This hidden table serves as the foundation for date-based relationships and time intelligence functions based on the Date LY (last year date) field from the CALENDARIO table. Contains standard date attributes including Year, Quarter, Month, and Day, with a default 'Date Hierarchy' for drill-down analysis. Date range is dynamically derived from the 'CALENDARIO' table's Date LY column (full years only). Used for year-over-year comparisons, same-period-last-year analysis, and LY reference calculations. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Local Date Table, Date Dimension, Time Dimension, Calendar Table, Date Hierarchy, Last Year Date Table, LY Date Table, Year-Over-Year Date Table"

	annotation DisplayFolder = "System Tables"

	annotation RefreshPolicy = "Dynamically generated based on CALENDARIO table data range. No manual refresh required. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana BI Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

