	partition 'Local Date Table - 2 Weeks Ago' = calculated
		mode: import
		source = Calendar(Date(Year(MIN('CALENDARIO'[DATA_2WAGO_DTA])), 1, 1), Date(Year(MAX('CALENDARIO'[DATA_2WAGO_DTA])), 12, 31))

		annotation Description = "Auto-generated local date table partition. Date range is dynamically calculated from the CALENDARIO table's DATA_2WAGO_DTA (2 weeks ago) column, spanning full years from the minimum to maximum bi-weekly offset year. This ensures the date table covers all two-weeks-ago dates referenced in the model. Used for bi-weekly comparisons and rolling 14-day performance tracking. Proposed – pending Loro Piana validation on data source and date range logic."

	annotation __PBI_LocalDateTable = true

	annotation Description = "Power BI auto-generated local date table providing a continuous date range for two-weeks-ago time intelligence calculations. This hidden table serves as the foundation for date-based relationships and time intelligence functions based on the DATA_2WAGO_DTA (2 weeks ago date) field from the CALENDARIO table. Contains standard date attributes including Year, Quarter, Month, and Day, with a default 'Date Hierarchy' for drill-down analysis. Date range is dynamically derived from the 'CALENDARIO' table's DATA_2WAGO_DTA column (full years only). Used for bi-weekly comparisons, two-week offset analysis, and rolling 14-day performance tracking. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Local Date Table, Date Dimension, Time Dimension, Calendar Table, Date Hierarchy, 2 Weeks Ago Date Table, Bi-Weekly Offset Date Table, Fourteen Day Offset"

	annotation DisplayFolder = "System Tables"

	annotation RefreshPolicy = "Dynamically generated based on CALENDARIO table data range. No manual refresh required. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana BI Team. Proposed – pending validation."

