table FAMIGLIA_COMMERCIALE
	lineageTag: 43b3d3a3-fcf6-4ef7-abf7-5c3fabbd96dc

	column CommercialFamilyCode
		dataType: string
		lineageTag: 625148c6-93c3-4c08-9016-33a19576617f
		summarizeBy: none
		sourceColumn: Commercial Family Code

		annotation SummarizationSetBy = Automatic

		annotation Description = "Unique code identifying a commercial family (e.g., 'RTW', 'LTH', 'ACC'). Used to link products to their commercial grouping and for reporting by family. Proposed – pending Loro Piana validation."

		annotation Synonyms = "Family Code, Commercial Group ID, Family ID, Market Code"

		annotation DisplayFolder = "Commercial Family"

		annotation 'Example Values' = "RTW, LTH, ACC, KNIT, WOVEN, BAG, SHO"

		annotation 'Common Questions' = "What is the commercial family code for Ready-to-Wear? How many products are in each commercial family? Which commercial family has the highest sales?"

		annotation 'Related Objects' = "ARTICOLI.'Commercial Family Code'"

	column CommercialFamilyDescription
		dataType: string
		lineageTag: dc04bc76-31ce-40d8-92c5-48a6b514080c
		summarizeBy: none
		sourceColumn: Commercial Family Description

		annotation SummarizationSetBy = Automatic

		annotation Description = "Business-friendly name of the commercial family (e.g., 'Ready-to-Wear', 'Leather Goods'). Use this field for labels, reporting, and visual grouping. Proposed – pending Loro Piana validation."

		annotation Synonyms = "Family Name, Commercial Family Name, Market Family Name, Family Description"

		annotation DisplayFolder = "Commercial Family"

		annotation 'Example Values' = "Ready-to-Wear, Leather Goods, Accessories, Knitwear, Woven Items, Bags, Shoes"

		annotation 'Common Questions' = "What is the commercial family name for code LTH? Which commercial family has the best performance? What is the revenue mix by commercial family?"

		annotation 'Related Objects' = "ARTICOLI.'Commercial Family Code'"

