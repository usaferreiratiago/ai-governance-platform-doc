		annotation Description = "Import partition for commercial family master data. Loads all commercial families without date filtering."

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

	annotation Description = "Commercial family dimension for the luxury retail assortment. Represents a mid-level product grouping within the commercial hierarchy, aggregating products for market positioning and pricing strategy. Links to products and business hierarchy for sales analysis. Grain: one row per commercial family code. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Commercial Family, Market Family, Product Family, Commercial Group, Family Dimension"

	annotation DisplayFolder = "Product Master"

	annotation RefreshPolicy = "Weekly on Sundays at 00:00 UTC; data latency ≤ 48 hours. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana Commercial Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "RTW: Ready-to-Wear, LTH: Leather Goods, ACC: Accessories, KNIT: Knitwear, WOVEN: Woven Items"

	annotation 'Common Questions' = "What are the commercial families? Which commercial family has the highest sales? How do commercial families compare to business categories? What is the revenue mix by commercial family?"

	annotation 'Related Objects' = "ARTICOLI.'Commercial Family Code', CLASSE_PRODOTTO, BUSINESS, SCONTRINI, TARGET"
