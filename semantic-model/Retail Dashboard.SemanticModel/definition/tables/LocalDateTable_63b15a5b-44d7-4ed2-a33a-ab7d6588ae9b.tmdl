	partition 'Local Date Table - End of Month' = calculated
		mode: import
		source = Calendar(Date(Year(MIN('CALENDARIO'[END_MONTH_DTA])), 1, 1), Date(Year(MAX('CALENDARIO'[END_MONTH_DTA])), 12, 31))

		annotation Description = "Auto-generated local date table partition. Date range is dynamically calculated from the CALENDARIO table's END_MONTH_DTA (end of month date) column, spanning full years from the minimum to maximum month-end year. This ensures the date table covers all end-of-month dates referenced in the model. Proposed – pending Loro Piana validation on data source and date range logic."

	annotation __PBI_LocalDateTable = true

	annotation Description = "Power BI auto-generated local date table providing a continuous date range for end-of-month time intelligence calculations. This hidden table serves as the foundation for date-based relationships and time intelligence functions based on the END_MONTH_DTA (end of month date) field from the CALENDARIO table. Contains standard date attributes including Year, Quarter, Month, and Day, with a default 'Date Hierarchy' for drill-down analysis. Date range is dynamically derived from the 'CALENDARIO' table's END_MONTH_DTA column (full years only). Proposed – pending Loro Piana validation."

	annotation Synonyms = "Local Date Table, Date Dimension, Time Dimension, Calendar Table, Date Hierarchy, End of Month Date Table, Month-End Date Table"

	annotation DisplayFolder = "System Tables"

	annotation RefreshPolicy = "Dynamically generated based on CALENDARIO table data range. No manual refresh required. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana BI Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "Date: 2024-01-31, Year: 2024, Quarter: Qtr 1, Month: January, Day: 31"

	annotation 'Common Questions' = "What is the date range based on end-of-month dates? How do I use the date hierarchy for month-end analysis? How do I filter by year, quarter, or month using end-of-month dates? What is the end-of-month date table used for?"

