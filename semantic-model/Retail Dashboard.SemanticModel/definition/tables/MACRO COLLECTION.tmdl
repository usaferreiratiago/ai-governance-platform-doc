table 'MACRO COLLECTION'
	lineageTag: 96becc69-6ef8-4139-a699-c5fec959cb44

	column MacroCollectionDescription
		dataType: string
		lineageTag: a8483996-10ed-42ce-9889-d00db9574ce7
		summarizeBy: none
		sourceColumn: Macro Collection

		annotation SummarizationSetBy = Automatic

		annotation Description = "Business-friendly name of the macro collection (e.g., 'Spring/Summer 2024', 'Fall/Winter 2024'). Use this field for labels and reporting. Proposed – pending Loro Piana validation."

		annotation Synonyms = "Collection Name, Collection Description, Macro Collection Name, Collection Theme"

		annotation DisplayFolder = "Collection Details"

		annotation 'Example Values' = "Spring/Summer 2024, Fall/Winter 2024, Resort 2024, Pre-Fall 2024"

		annotation 'Common Questions' = "What is the macro collection for SS24? How do different collections perform? What are the collection names?"

		annotation 'Related Objects' = "ARTICOLI_COLORE"

	column MacroCollectionCode
		dataType: string
		lineageTag: c2aa0021-689e-4394-938f-f8ce3c7d177d
		summarizeBy: none
		sourceColumn: Macro Collection Code

		annotation SummarizationSetBy = Automatic

		annotation Description = "Unique code identifying the macro collection (e.g., 'SS24', 'FW24', 'RES24'). Used to link product-color variants to their collection. Proposed – pending Loro Piana validation."

		annotation Synonyms = "Collection Code, Collection ID, Collection Reference, Macro Collection ID"

		annotation DisplayFolder = "Collection Details"

		annotation 'Example Values' = "SS24, FW24, RES24, PF24"

		annotation 'Common Questions' = "What is the collection code for Spring/Summer 2024? How many products are in each collection? Which collection has the highest sales?"

		annotation 'Related Objects' = "ARTICOLI_COLORE"

	column MacroCollectionSortOrder
