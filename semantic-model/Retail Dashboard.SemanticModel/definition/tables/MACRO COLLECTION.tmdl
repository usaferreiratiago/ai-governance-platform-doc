	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

	annotation Description = "Macro collection dimension for the luxury retail assortment. Defines high-level collection groupings used to organize products into major collection themes (e.g., 'Spring/Summer', 'Fall/Winter', 'Resort', 'Pre-Fall'). Links to product-color variants for collection-based analysis and assortment planning. Grain: one row per macro collection. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Macro Collection, Collection Group, Collection Theme, Seasonal Collection, Assortment Collection"

	annotation DisplayFolder = "Product Master"

	annotation RefreshPolicy = "Weekly on Sundays at 00:00 UTC; data latency ≤ 48 hours. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana Product Management Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "SS24: Spring/Summer 2024, FW24: Fall/Winter 2024, RES24: Resort 2024, PF24: Pre-Fall 2024"

	annotation 'Common Questions' = "What are the macro collections? How do collections compare by sales? Which macro collection has the highest sell-through? What is the performance of Spring/Summer vs Fall/Winter?"

	annotation 'Related Objects' = "ARTICOLI_COLORE, ARTICOLI, CLASSE_PRODOTTO, BUSINESS, SCONTRINI"
