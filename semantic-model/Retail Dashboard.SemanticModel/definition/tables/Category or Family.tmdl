	partition 'Category or Family' = calculated
		mode: import
		source =
				{
				    ("Category", NAMEOF('SCONTRINI'[Category]), 0),
				    ("Commercial Family", NAMEOF('FAMIGLIA_COMMERCIALE'[Commercial Family Description]), 1)
				}

		annotation Description = "Calculated partition that unions Category values from SCONTRINI and Commercial Family descriptions from FAMIGLIA_COMMERCIALE into a single selection dimension. The 'Category' source provides values from transaction-level categories; 'Commercial Family' provides commercial grouping values from the product hierarchy."

	annotation PBI_Id = d40c037462e740a8939aa8425d8daef0

	annotation Description = "Calculated dimension that unions product Category and Commercial Family into a single selection list for multi-select visuals and dynamic filtering. Enables users to filter by either Category (from sales transactions) or Commercial Family (from product hierarchy) using one unified field. Grain: one row per Category or Commercial Family combination. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Category or Commercial Family, Product Group Selection, Unified Category/Family, Filter Dimension"

	annotation DisplayFolder = "Product Master"

	annotation RefreshPolicy = "Weekly on Sundays at 00:00 UTC; data latency ≤ 48 hours. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana Commercial Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "Bags (from Category), Shoes (from Category), Ready-to-Wear (from Commercial Family), Accessories (from Commercial Family)"

	annotation 'Common Questions' = "What is the difference between Category and Commercial Family? How do I filter by both Category and Commercial Family? Which products are in the Bags Category versus the Ready-to-Wear Commercial Family?"

	annotation 'Related Objects' = "SCONTRINI.'Category', FAMIGLIA_COMMERCIALE.'Commercial Family Description', CLASSE_PRODOTTO, ARTICOLI"
