		lineageTag: 3fec8bfd-6277-4642-8d1b-25ccfbce1a13
		summarizeBy: none
		sourceColumn: Marketing Type Code

		annotation SummarizationSetBy = Automatic

		annotation Description = "Unique code identifying a marketing type classification (e.g., 'M01', 'M02', 'M03'). Used to link product-color variants to their marketing type category. Proposed – pending Loro Piana validation."

