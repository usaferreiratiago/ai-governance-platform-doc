	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

	annotation Description = "Marketing type dimension for the luxury retail assortment. Defines product classification logic used for marketing and promotional strategies (e.g., 'Core', 'Seasonal', 'Promotional', 'Exclusive'). Links to product-color variants to identify marketing type classifications for campaign planning and performance analysis. Grain: one row per marketing type code. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Marketing Type, Marketing Classification, Promotional Category, Marketing Strategy, Campaign Category"

	annotation DisplayFolder = "Product Master"

	annotation RefreshPolicy = "Weekly on Sundays at 00:00 UTC; data latency ≤ 48 hours. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana Marketing Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "M01: Core, M02: Seasonal, M03: Promotional, M04: Exclusive, M05: Capsule"

	annotation 'Common Questions' = "What are the marketing type classifications? How do marketing types differ? Which products are in each marketing type? How does marketing type influence promotional performance?"

	annotation 'Related Objects' = "ARTICOLI_COLORE.'Marketing Type Code', ARTICOLI, CLASSE_PRODOTTO, SCONTRINI, TARGET"
