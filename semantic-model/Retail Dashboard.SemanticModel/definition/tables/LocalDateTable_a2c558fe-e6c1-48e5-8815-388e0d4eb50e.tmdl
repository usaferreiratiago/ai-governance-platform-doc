	partition 'Local Date Table - Delivery End Date' = calculated
		mode: import
		source = Calendar(Date(Year(MIN('ARTICOLI_COLORE'[Delivery Date To])), 1, 1), Date(Year(MAX('ARTICOLI_COLORE'[Delivery Date To])), 12, 31))

		annotation Description = "Auto-generated local date table partition. Date range is dynamically calculated from the ARTICOLI_COLORE table's Delivery Date To column, spanning full years from the minimum to maximum delivery end year. This ensures the date table covers all delivery end dates referenced in the model. Used for delivery window analysis, end-of-delivery tracking, logistics performance monitoring, and supply chain planning. Proposed – pending Loro Piana validation on data source and date range logic."

	annotation __PBI_LocalDateTable = true

	annotation Description = "Power BI auto-generated local date table providing a continuous date range for delivery end date-based time intelligence calculations. This hidden table serves as the foundation for date-based relationships and time intelligence functions based on the Delivery Date To field from the ARTICOLI_COLORE (Product Color Variant) table. Contains standard date attributes including Year, Quarter, Month, and Day, with a default 'Date Hierarchy' for drill-down analysis. Date range is dynamically derived from the 'ARTICOLI_COLORE' table's Delivery Date To column (full years only). Used for delivery window analysis, end-of-delivery tracking, logistics performance monitoring, and supply chain planning. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Local Date Table, Date Dimension, Time Dimension, Calendar Table, Date Hierarchy, Delivery End Date Table, Delivery Window Date Table"

	annotation DisplayFolder = "System Tables"

	annotation RefreshPolicy = "Dynamically generated based on ARTICOLI_COLORE table data range. No manual refresh required. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana BI Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "Date: 2024-01-01, Year: 2024, Quarter: Qtr 1, Month: January, Day: 1"

	annotation 'Common Questions' = "What is the delivery end date range? How do I use the date hierarchy for delivery window analysis? How do I filter by delivery end year, quarter, or month? What is the delivery end date table used for?"

	annotation 'Related Objects' = "ARTICOLI_COLORE, SCONTRINI, TARGET, CLASSE_PRODOTTO"

	annotation __PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
