		annotation SummarizationSetBy = Automatic

		annotation Description = "Target currency code (e.g., 'EUR', 'USD', 'GBP') for which exchange rates are defined. Used to convert local currency targets to reporting currency. Proposed – pending Loro Piana validation."

		annotation Synonyms = "Currency, Target Currency, Reporting Currency, FX Currency"

		annotation DisplayFolder = "Currency"

		annotation 'Example Values' = "EUR, USD, GBP, CHF, JPY"

		annotation 'Common Questions' = "What currencies are available for target conversion? How do I convert targets to EUR?"

		annotation 'Related Objects' = "TARGET[Currency]"

