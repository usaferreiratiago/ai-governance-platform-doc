		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

		annotation Description = "Planning year for which the exchange rates apply (e.g., '2024', '2025'). Used to filter target exchange rates by planning period. Proposed – pending Loro Piana validation."

		annotation Synonyms = "Year, Fiscal Year, Planning Year, Budget Year"

		annotation DisplayFolder = "Time"

		annotation 'Example Values' = "2024, 2025, 2026"

		annotation 'Common Questions' = "What year are the exchange rates for? How do exchange rates vary by year?"

		annotation 'Related Objects' = "TARGET[Year]"

	column TargetCurrency
