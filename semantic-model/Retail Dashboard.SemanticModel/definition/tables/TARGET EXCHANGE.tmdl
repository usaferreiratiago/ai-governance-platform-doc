	partition 'TARGET EXCHANGE' = m
		mode: import
		source =
				let
				        Source = PowerPlatform.Dataflows(null),
				        Workspaces = Source{[Id="Workspaces"]}[Data],
				        WS = Workspaces{[workspaceId="3cb5ae18-3ac2-45e3-937b-8f934a66d860"]}[Data],
				        DF = WS{[dataflowId="443da8fa-2e20-444b-a3a1-1345a5b54ee1"]}[Data],
				        CAMBI_TARGET1 = DF{[entity="CAMBI_TARGET"]}[Data],
				        #"Removed Other Columns" = Table.SelectColumns(CAMBI_TARGET1,{"Year", "Currency Target", "Exchange Original", "Exchange Revised", "KEY_ANNO_CURR", "Rate_R1", "Rate_R2", "Rate_B2", "Rate_PCL"})
				in
				        #"Removed Other Columns"

		annotation Description = "Import partition for target exchange rate master data. Loads all exchange rates by year and currency. Contains multiple rate types: Original Exchange, Revised Exchange, and scenario rates (R1, R2, B2, PCL)."

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

	annotation Description = "Target exchange rate dimension for currency conversion in target and budget planning. Contains exchange rates used to convert target figures from local currencies to reporting currencies. Includes multiple rate types: Original exchange rates, Revised exchange rates, and scenario-specific rates (R1, R2, B2, PCL). Used for financial planning, budgeting, and target setting across different currencies. Grain: one row per year and target currency. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Target Exchange, Exchange Rates, Currency Conversion, FX Rates, Target Currency Rates, Planning Exchange"

	annotation DisplayFolder = "Financial Master"

	annotation RefreshPolicy = "Annually or as needed for planning cycles. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana Finance Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "Year: 2024, Currency: EUR, Exchange: 1.00"

	annotation 'Common Questions' = "What exchange rates are used for target planning? How do I convert targets to reporting currency? What is the difference between Original and Revised exchange rates? What are the different rate scenarios (R1, R2, B2, PCL)?"

	annotation 'Related Objects' = "TARGET, BUDGET, SCONTRINI, EXCHANGE_RATES"
