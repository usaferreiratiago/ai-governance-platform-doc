	column Clients =
			IF(
				SCONTRINI[Flag Gen] = CONVERT(1, STRING),
				SCONTRINI['Ticket ID'],
				CONVERT(SCONTRINI['Customer Code'], STRING)
			)
			lineageTag: 72ffd5bd-efdc-4cd1-bb49-45d9eb9fe169
			summarizeBy: none
			displayFolder: "02. Customer"
			annotation Description = "Business customer identifier used for customer-level analysis. For generic customers, the ticket identifier is used instead of the source customer code."
			annotation SummarizationSetBy = Automatic
		lineageTag: 6adbc409-65e1-416f-8740-8a6b7096ae7f

