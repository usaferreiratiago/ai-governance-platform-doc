	column Unit_DAX =
			IF(
				SCONTRINI['Unit of Measure'] <> "NR",
				1,
				SCONTRINI[Quantity]
			)
			dataType: int64
			formatString: "#,##0"
			lineageTag: a3e09f7b-9ec7-4525-aa53-bba2c34424bd
			summarizeBy: sum
			displayFolder: "07. Sales & Revenue"
			annotation Description = "Normalized unit quantity used for business unit analysis. For non-NR units of measure, each transaction line is counted as one unit."
			annotation SummarizationSetBy = Automatic
		lineageTag: 895b4053-938b-4985-82c2-6a0fa486be5d

	column 'Flag Gen' =
			RELATED(CUSTOMER[FlagGeneric])
