table SCONTRINI
	lineageTag: 88b5d8cc-025d-4a0a-b3d3-59aee1560e3f

	measure 'Total Net Sales EUR' = ```
			
			        SUM(SCONTRINI[Net Sales Eur])
			```
		lineageTag: 7e0204d1-5bcc-4b61-ab12-0d12b9323aaa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Sales Local Currency' =
			SUM(SCONTRINI['Net Sales Ccy'])
			formatString: "#,##0.00"
			displayFolder: "07. Sales & Revenue"
			annotation Description = "Total net sales amount in the transaction currency. Use Currency as the currency context. Do not compare values across currencies without applying currency conversion."
		lineageTag: 72bb8b7e-4d93-4a71-ab0e-68a72286785b

	measure 'Collected Amount EUR' =
			SUM(SCONTRINI[INCASSATO_EUR])
			formatString: "#,##0.00"
			displayFolder: "07. Sales & Revenue"
			annotation Description = "Total collected amount in EUR based on INCASSATO_EUR."
		lineageTag: 85ebf09d-61d5-40a2-bfbd-bb9fd0fb7d6b

	measure 'Collected Amount Local Currency' =
			SUM(SCONTRINI[INCASSATO_VAL])
			formatString: "#,##0.00"
			displayFolder: "07. Sales & Revenue"
			annotation Description = "Total collected amount in the transaction currency."
		lineageTag: a6d16e00-0219-46db-ae4a-214fcb79e998

	measure 'Quantity Sold' =
			SUM(SCONTRINI[Quantity])
			formatString: "#,##0"
			displayFolder: "07. Sales & Revenue"
			annotation Description = "Total quantity sold across transaction lines."
		lineageTag: 29e61b5d-e856-42ae-8338-74a65ee522ae

	measure 'Units Sold' =
			SUM(SCONTRINI[Unit_DAX])
			formatString: "#,##0"
			displayFolder: "07. Sales & Revenue"
			annotation Description = "Business unit count derived from Unit of Measure and Quantity. When Unit of Measure is not NR, one transaction line is treated as one unit."
		lineageTag: 116f4684-c2f8-4b28-9d03-1c2ce8de8fcb

	measure 'Ticket Count' =
			DISTINCTCOUNT(SCONTRINI['Ticket ID'])
			formatString: "#,##0"
			displayFolder: "01. Transaction"
			annotation Description = "Number of distinct sales tickets represented in the filtered transaction context."
		lineageTag: 9f07b5ea-67c3-4790-8b49-26a66d0d612a

	measure 'Customer Count' =
			DISTINCTCOUNT(SCONTRINI[Clients])
			formatString: "#,##0"
			displayFolder: "02. Customer"
			annotation Description = "Number of distinct customers represented in the transaction context. Generic or anonymous customers may be represented using the ticket identifier according to the Clients business logic"
		lineageTag: bd6337a2-c1c9-4496-a373-db959c60ccbc

	measure 'Total Discount EUR' =
			SUM(SCONTRINI['Discount Eur'])
			formatString: "#,##0.00"
			displayFolder: "08. Discounts"
			annotation Description = "Total discount amount in EUR."
		lineageTag: 35cbba2c-ae84-4927-b77f-eb9cb1d89983

	measure 'Discount Local Currency' =
			SUM(SCONTRINI['Discount Ccy'])
			formatString: "#,##0.00"
			displayFolder: "08. Discounts"
			annotation Description = "Total discount amount in the transaction currency."
		lineageTag: a8318c9f-1140-4f1d-8164-d4da8e0f9d84

	measure 'Total Retail Sales Price EUR' =
			SUM(SCONTRINI['Retail Sales Price Eur'])
			formatString: "#,##0.00"
			displayFolder: "07. Sales & Revenue"
			annotation Description = "Total retail sales price in EUR before applicable transaction-level adjustments."
		lineageTag: 4a775ed0-6a52-4be8-9e71-2b321aa40227

	measure 'Total Original Sales Price EUR' =
			SUM(SCONTRINI['Original Sales Price Eur'])
			formatString: "#,##0.00"
			displayFolder: "07. Sales & Revenue"
			annotation Description = "Total original sales price in EUR before discounts or other adjustments."
		lineageTag: 4ecf9375-c70c-4d82-ac59-0e0611851c01

