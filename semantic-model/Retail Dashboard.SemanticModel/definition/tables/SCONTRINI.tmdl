	partition SCONTRINI-703e07f8-86b0-4c9c-94c4-5eb2c5cad79c = m
		mode: import
		source =
				let
					Source = PowerPlatform.Dataflows(null),
					Workspaces = Source{[Id="Workspaces"]}[Data],
					WS = Workspaces{[workspaceId="3cb5ae18-3ac2-45e3-937b-8f934a66d860"]}[Data],
					DF = WS{[dataflowId="d9d9454f-83f9-4194-8ec6-71119a47a12e"]}[Data],
					SCONTRINI1 = DF{[entity="SCONTRINI"]}[Data],
				
					#"Filtered Rows" =
						Table.SelectRows(
							SCONTRINI1,
							each [Date] >= #datetime(2021, 1, 1, 0, 0, 0)
						),
				
					#"Rimosse altre colonne" =
						Table.SelectColumns(
							#"Filtered Rows",
							{
								"Ticket ID",
								"Ticket Row ID",
								"Customer Code",
								"Store Code",
								"Sales Associate Code",
								"Ticket Type",
								"Flag Distant Sales",
								"Date",
								"Ticket Row Type",
								"Ticket Row Description",
								"Item Code",
								"Retail Year",
								"Retail Season",
								"Retail Collection",
								"Year Fuori Cartella",
								"Season Fuori Cartella",
								"Batch Year",
								"Batch Season",
								"Buying Logic Code",
								"Marketing Type Code",
								"Analysis Year",
								"Analysis Season",
								"Physical Status Code",
								"Color Code",
								"Size",
								"Unit of Measure",
								"Quantity",
								"Sign",
								"Currency",
								"Retail Sales Price Eur",
								"Retail Sales Price Ccy",
								"Original Sales Price Eur",
								"Original Sales Price Ccy",
								"Retail Sales NO VAT Ccy",
								"Original Price NO VAT Ccy",
								"INCASSATO_VAL",
								"INCASSATO_EUR",
								"Discount Reason Code",
								"Flag Sale",
								"Discount Ccy",
								"Discount Eur",
								"SCONTO1_EUR_VAL",
								"SCONTO1_LOC_VAL",
								"SCONTO2_EUR_VAL",
								"SCONTO2_LOC_VAL",
								"SCONTO3_EUR_VAL",
								"SCONTO3_LOC_VAL",
								"SCONTO_IMP_EUR_VAL",
								"SCONTO_IMP_LOC_VAL",
								"COD_CAU1_SCT",
								"SCONTO1_IMP_EUR_VAL",
								"SCONTO1_IMP_LOC_VAL",
								"COD_CAU2_SCT",
								"SCONTO2_IMP_EUR_VAL",
								"SCONTO2_IMP_LOC_VAL",
								"COD_CAU3_SCT",
								"SCONTO3_IMP_EUR_VAL",
								"SCONTO3_IMP_LOC_VAL",
								"Net Sales Ccy",
								"Net Sales Eur",
								"Standard Civ Cost Eur",
								"Standard Civ Cost Ccy",
								"Standard Gest Cost Eur",
								"Standard Gest Cost Ccy",
								"Transaction Type Code",
								"Transfer Eur",
								"Transfer Ccy",
								"COD_TIPO_MARK",
								"COD_QUALITA",
								"Country Ship To Code",
								"COD_SALES_MARK_ATTRIBUTE",
								"Retail Sales Price ITA",
								"DATA_VARIAZ",
								"KEY_ART_COL",
								"UNIT",
								"Offer Code",
								"Macro Collection Code"
							}
						),
				
					#"Added Year" =
						Table.AddColumn(
							#"Rimosse altre colonne",
							"Year",
							each Date.Year([Date]),
							Int64.Type
						),
				
					#"Added Currency Key" =
						Table.AddColumn(
							#"Added Year",
							"Key Anno Currency",
							each Text.Combine(
								{
									Text.From([Year]),
									[Currency]
								},
								""
							),
							type text
						),
				
					#"Filtered Ticket Rows" =
						Table.SelectRows(
							#"Added Currency Key",
							each [Ticket Row Type] = "RES"
								or [Ticket Row Type] = "SPE"
								or [Ticket Row Type] = "VEN"
						)
				
				in
					#"Filtered Ticket Rows"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

	annotation __LLM_SemanticRole = "Transactional sales fact table"

	annotation __LLM_BusinessDescription = "SCONTRINI contains transactional retail sales data at ticket-line level. Each row represents a transaction line associated with a ticket, customer, store, product, date, quantity, pricing, discounts, currency and sales values."

	annotation __LLM_Grain = "One row per ticket transaction line after filtering Ticket Row Type to RES, SPE or VEN."

	annotation __LLM_Guidance = "Use additive monetary and quantity measures for aggregation. Do not aggregate customer, ticket, product or transaction identifiers. Use distinct counts for tickets and customers where appropriate."
