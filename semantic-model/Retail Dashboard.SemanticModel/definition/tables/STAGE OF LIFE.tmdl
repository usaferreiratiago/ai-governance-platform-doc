table 'STAGE OF LIFE'
	lineageTag: 2ea44f5d-ac80-4e1a-9c2d-244efa67217b

	column LifecycleStageCode
		dataType: string
		lineageTag: a43ea075-f843-413d-b73d-324a96a0287f
		summarizeBy: none
		sourceColumn: Stage of Life Code

		annotation SummarizationSetBy = Automatic

		annotation Description = "Unique code identifying a product lifecycle stage (e.g., 'NEW' for new/current season, 'OLD' for prior season, 'DIS' for discontinued). Used to link products to their lifecycle stage. Proposed – pending Loro Piana validation."

		annotation Synonyms = "Stage Code, Lifecycle Code, Product Stage Code, Seasonality Code"

		annotation DisplayFolder = "Lifecycle Details"

		annotation 'Example Values' = "NEW, OLD, DIS, SAMPLE, TEST"

		annotation 'Common Questions' = "What is the lifecycle stage code for New products? How many products are in each lifecycle stage? Which lifecycle stage has the highest sell-through?"

		annotation 'Related Objects' = "ARTICOLI.'Stage of Life Code'"

