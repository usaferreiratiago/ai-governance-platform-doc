		annotation 'Example Values' = "New/Current Season, Old/Prior Season, Discontinued, Sample, Test Product"

		annotation 'Common Questions' = "What is the lifecycle stage description for code NEW? How do I filter by lifecycle stage? What are the product lifecycle categories?"

		annotation 'Related Objects' = "ARTICOLI.'Stage of Life Code'"

