		annotation Description = "Business-friendly description of the product lifecycle stage (e.g., 'New/Current Season', 'Old/Prior Season', 'Discontinued'). Use for labels and reporting. Proposed – pending Loro Piana validation."

		annotation Synonyms = "Stage Name, Lifecycle Stage, Product Stage Name, Seasonality Description"

