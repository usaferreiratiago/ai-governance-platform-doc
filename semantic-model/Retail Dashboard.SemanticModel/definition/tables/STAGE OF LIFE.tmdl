	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

	annotation Description = "Product lifecycle stage dimension for the luxury retail assortment. Defines the product lifecycle status (e.g., 'NEW' for current season, 'OLD' for prior season, 'DIS' for discontinued). Used for assortment planning, inventory management, and performance analysis by lifecycle stage. Links to products for lifecycle-based reporting. Grain: one row per stage of life code. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Lifecycle Stage, Product Stage, Stage of Life, Product Lifecycle, Seasonality Stage"

	annotation DisplayFolder = "Product Master"

	annotation RefreshPolicy = "Weekly on Sundays at 00:00 UTC; data latency ≤ 48 hours. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana Product Management Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "NEW: New/Current Season, OLD: Old/Prior Season, DIS: Discontinued, SAMPLE: Sample, TEST: Test Product"

	annotation 'Common Questions' = "What are the product lifecycle stages? How do new products perform vs old? Which products are discontinued? What is the stage distribution of our assortment? How does lifecycle stage affect sell-through?"

	annotation 'Related Objects' = "ARTICOLI.'Stage of Life Code', CLASSE_PRODOTTO, SCONTRINI, TARGET"
