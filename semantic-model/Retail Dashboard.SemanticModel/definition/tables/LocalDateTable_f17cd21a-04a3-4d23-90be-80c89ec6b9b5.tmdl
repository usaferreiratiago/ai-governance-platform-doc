	partition 'Local Date Table - Fiscal Week Order' = calculated
		mode: import
		source = Calendar(Date(Year(MIN('CALENDARIO'[year_month_week_fiscal_ord])), 1, 1), Date(Year(MAX('CALENDARIO'[year_month_week_fiscal_ord])), 12, 31))

		annotation Description = "Auto-generated local date table partition. Date range is dynamically calculated from the CALENDARIO table's year_month_week_fiscal_ord (fiscal week order) column, spanning full years from the minimum to maximum fiscal week order year. This ensures the date table covers all fiscal week order dates referenced in the model. Used for fiscal week sequencing, week-of-year ordering, and fiscal calendar reporting. Proposed – pending Loro Piana validation on data source and date range logic."

	annotation __PBI_LocalDateTable = true

	annotation Description = "Power BI auto-generated local date table providing a continuous date range for fiscal week ordering time intelligence calculations. This hidden table serves as the foundation for date-based relationships and time intelligence functions based on the year_month_week_fiscal_ord (fiscal week order) field from the CALENDARIO table. Contains standard date attributes including Year, Quarter, Month, and Day, with a default 'Date Hierarchy' for drill-down analysis. Date range is dynamically derived from the 'CALENDARIO' table's year_month_week_fiscal_ord column (full years only). Used for fiscal week sequencing, week-of-year ordering, and fiscal calendar reporting. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Local Date Table, Date Dimension, Time Dimension, Calendar Table, Date Hierarchy, Fiscal Week Order Date Table, Fiscal Calendar Date Table"

	annotation DisplayFolder = "System Tables"

	annotation RefreshPolicy = "Dynamically generated based on CALENDARIO table data range. No manual refresh required. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana BI Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "Date: 2024-01-01, Year: 2024, Quarter: Qtr 1, Month: January, Day: 1"

	annotation 'Common Questions' = "What is the fiscal week order date range? How do I use the date hierarchy for fiscal week sequencing? How do I filter by fiscal year, quarter, or month? What is the fiscal week order date table used for?"

