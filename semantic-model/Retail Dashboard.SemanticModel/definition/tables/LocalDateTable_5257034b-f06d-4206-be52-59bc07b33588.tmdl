	partition 'Local Date Table - 2 Day Offset' = calculated
		mode: import
		source = Calendar(Date(Year(MIN('CALENDARIO'[DATA_2AGO_DTA])), 1, 1), Date(Year(MAX('CALENDARIO'[DATA_2AGO_DTA])), 12, 31))

		annotation Description = "Auto-generated local date table partition. Date range is dynamically calculated from the CALENDARIO table's DATA_2AGO_DTA (2 days ago) column, spanning full years from the minimum to maximum offset year. This ensures the date table covers all 2-day offset dates referenced in the model. Proposed – pending Loro Piana validation on data source and date range logic."

	annotation __PBI_LocalDateTable = true

	annotation Description = "Power BI auto-generated local date table providing a continuous date range for time intelligence calculations based on the DATA_2AGO_DTA (2 days ago) date field from the CALENDARIO table. This hidden table serves as the foundation for date-based relationships and time intelligence functions that require a 2-day offset reference. Contains standard date attributes including Year, Quarter, Month, and Day, with a default 'Date Hierarchy' for drill-down analysis. Date range is dynamically derived from the 'CALENDARIO' table's DATA_2AGO_DTA column (full years only). Proposed – pending Loro Piana validation."

	annotation Synonyms = "Local Date Table, Date Dimension, Time Dimension, Calendar Table, Date Hierarchy, 2 Day Offset Date Table"

	annotation DisplayFolder = "System Tables"

	annotation RefreshPolicy = "Dynamically generated based on CALENDARIO table data range. No manual refresh required. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana BI Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

