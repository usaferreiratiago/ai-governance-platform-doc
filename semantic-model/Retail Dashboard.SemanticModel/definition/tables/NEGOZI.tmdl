	column 'Has Tickets' = IF(COUNTROWS(RELATEDTABLE('SCONTRINI')) > 0, 1, 0)
		formatString: 0
		lineageTag: c47ed2f3-2a26-498a-b507-7762d334763b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation Description = "Flag indicating if the store has any sales transactions. Returns 1 if there are tickets (sales), 0 otherwise. Useful for identifying active vs. inactive stores. Proposed – pending Loro Piana validation."

		annotation Synonyms = "Has Sales, Active Store Flag, Store with Tickets"

		annotation DisplayFolder = "Store Metrics"

		annotation 'Example Values' = "1 (has sales), 0 (no sales)"

		annotation 'Common Questions' = "Which stores have sales? Which stores are inactive? How many stores have no transactions?"

		annotation 'Related Objects' = "SCONTRINI"

	partition NEGOZI = m
		mode: import
		source =
				let
				        Origine = PowerPlatform.Dataflows(null),
				        Workspaces = Origine{[Id="Workspaces"]}[Data],
				        WS = Workspaces{[workspaceId="63075e43-ec19-4090-b204-854337b4b0d5"]}[Data],
				        DF = WS{[dataflowId="9e62577e-6b91-4666-b6c3-868d086245db"]}[Data],
				        NEGOZI1 = DF{[entity="NEGOZI"]}[Data],
				        // Select base columns from source
				        #"Removed Other Columns" = Table.SelectColumns(NEGOZI1,{"Area Code", "Store Description", "Store Code", "Store Code DWH", "Flag L4L 1year", "Flag L4L 2years", "Country Code", "Profit Center Code", "HFM Code", "Area Manager Code", "KEY_NGZ_HFM", "KEY_NGZ_UR_HFM_PC", "DATA_CHIUSURA", "COD_TIPOLOGIA", "Logistic Area"}),
				        // Replace L4L flag values: 1->L4L, 0->Not L4L
				        #"Replaced Value" = Table.ReplaceValue(#"Removed Other Columns","1","L4L",Replacer.ReplaceText,{"Flag L4L 1year"}),
				        #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value","0","Not L4L",Replacer.ReplaceText,{"Flag L4L 1year"}),
				        // Merge with AREA_MANAGER for manager names
				        #"Merged Queries" = Table.NestedJoin(#"Replaced Value1", {"Area Manager Code"}, AREA_MANAGER, {"Area Manager Code"}, "AREA_MANAGER", JoinKind.LeftOuter),
				        #"Expanded AREA_MANAGER" = Table.ExpandTableColumn(#"Merged Queries", "AREA_MANAGER", {"Area Manager Description"}, {"Area Manager Description"}),
				        // Merge with GERARCHIA_AREA for area descriptions
				        #"Merged Queries1" = Table.NestedJoin(#"Expanded AREA_MANAGER", {"Area Code"}, GERARCHIA_AREA, {"Area Code"}, "GERARCHIA_AREA", JoinKind.LeftOuter),
				        #"Expanded GERARCHIA_AREA" = Table.ExpandTableColumn(#"Merged Queries1", "GERARCHIA_AREA", {"Area Description"}, {"Area Description"}),
				        // Merge with NAZIONI for country descriptions
				        #"Merged Queries2" = Table.NestedJoin(#"Expanded GERARCHIA_AREA", {"Country Code"}, NAZIONI, {"Country Code"}, "NAZIONI", JoinKind.LeftOuter),
				        #"Expanded NAZIONI" = Table.ExpandTableColumn(#"Merged Queries2", "NAZIONI", {"Country Description"}, {"Country Description"}),
				        // Capitalize country descriptions
				        #"Capitalized Each Word" = Table.TransformColumns(#"Expanded NAZIONI",{{"Country Description", Text.Proper, type text}}),
				        // Remove stores ending with 'B' (closed or test stores)
				        #"Filtered Rows" = Table.SelectRows(#"Capitalized Each Word", each not Text.EndsWith([Store Code], "B")),
				        // Final merge for hierarchy area description
				        #"Merged Queries Final" = Table.NestedJoin(#"Filtered Rows", {"Area Code"}, GERARCHIA_AREA, {"Area Code"}, "GERARCHIA_AREA", JoinKind.LeftOuter),
				        #"Expanded GERARCHIA_AREA Final" = Table.ExpandTableColumn(#"Merged Queries Final", "GERARCHIA_AREA", {"Area Description"}, {"GERARCHIA_AREA.Area Description"})
				in
				        #"Expanded GERARCHIA_AREA Final"

		annotation Description = "Import partition for store master data. Performs multiple joins to enrich store data with area, country, and area manager attributes. Note: Hardcoded L4L flag replacements (1→L4L, 0→Not L4L) and filter removing stores ending with 'B' (closed/test stores). Proposed – pending Loro Piana validation on these business rules."

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

	annotation Description = "Store master dimension for the luxury retail model. Contains store-level attributes including codes, descriptions, geographic and organizational hierarchy references (Area, Country, Area Manager), operational flags (Like-for-Like, closure date, store type), and financial codes (Profit Center, HFM). Pre-joined with Area, Country, and Area Manager dimensions for simplified reporting. Grain: one row per store. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Stores, Store Master, Store Dimension, Retail Outlets, Boutiques, Store Locations"

	annotation DisplayFolder = "Store Master"

	annotation RefreshPolicy = "Weekly on Sundays at 00:00 UTC; data latency ≤ 48 hours. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana Retail Operations Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "Store: LP001 - Milano Via Montenapoleone, Area: Italy, Country: Italy, Area Manager: Giuseppe Rossi"

	annotation 'Common Questions' = "Which stores are in our network? How do stores perform by sales? What stores are Like-for-Like? Which stores are closed? How do stores compare by country and area?"

	annotation 'Related Objects' = "SCONTRINI, TARGET, BUDGET, AREA_MANAGER, GERARCHIA_AREA, NAZIONI"
