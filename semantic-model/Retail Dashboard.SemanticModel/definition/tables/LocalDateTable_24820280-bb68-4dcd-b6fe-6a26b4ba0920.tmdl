	partition 'Local Date Table' = calculated
		mode: import
		source = Calendar(Date(Year(MIN('CALENDARIO'[DAAT_3WAGO_DTA])), 1, 1), Date(Year(MAX('CALENDARIO'[DAAT_3WAGO_DTA])), 12, 31))

		annotation Description = "Auto-generated local date table partition. Date range is dynamically calculated from the CALENDARIO table's DAAT_3WAGO_DTA column, spanning full years from the minimum to maximum year. This ensures the date table covers all dates referenced in the model. Proposed – pending Loro Piana validation on data source and date range logic."

	annotation __PBI_LocalDateTable = true

	annotation Description = "Power BI auto-generated local date table providing a continuous date range for time intelligence calculations. This hidden table serves as the foundation for date-based relationships and time intelligence functions across the semantic model. Contains standard date attributes including Year, Quarter, Month, and Day, with a default 'Date Hierarchy' for drill-down analysis. Date range is dynamically derived from the 'CALENDARIO' table's DAAT_3WAGO_DTA column (full years only). Proposed – pending Loro Piana validation."

	annotation Synonyms = "Local Date Table, Date Dimension, Time Dimension, Calendar Table, Date Hierarchy"

	annotation DisplayFolder = "System Tables"

	annotation RefreshPolicy = "Dynamically generated based on CALENDARIO table data range. No manual refresh required. Proposed – pending Loro Piana validation."

