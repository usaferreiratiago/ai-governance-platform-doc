	partition 'Local Date Table - 3 Day Ago Date' = calculated
		mode: import
		source = Calendar(Date(Year(MIN('CALENDARIO'[COD_3AGO_DTA])), 1, 1), Date(Year(MAX('CALENDARIO'[COD_3AGO_DTA])), 12, 31))

		annotation Description = "Auto-generated local date table partition. Date range is dynamically calculated from the CALENDARIO table's COD_3AGO_DTA (3 days ago) column, spanning full years from the minimum to maximum three-day offset year. This ensures the date table covers all 3-day ago dates referenced in the model. Used for 3-day ago comparisons, rolling three-day analysis, and short-term trend tracking. Proposed – pending Loro Piana validation on data source and date range logic."

	annotation __PBI_LocalDateTable = true

	annotation Description = "Power BI auto-generated local date table providing a continuous date range for time intelligence calculations based on the COD_3AGO_DTA (3 days ago date) field from the CALENDARIO table. This hidden table serves as the foundation for date-based relationships and time intelligence functions that require a 3-day offset reference. Contains standard date attributes including Year, Quarter, Month, and Day, with a default 'Date Hierarchy' for drill-down analysis. Date range is dynamically derived from the 'CALENDARIO' table's COD_3AGO_DTA column (full years only). Used for 3-day ago comparisons, rolling three-day analysis, and short-term trend tracking. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Local Date Table, Date Dimension, Time Dimension, Calendar Table, Date Hierarchy, 3 Day Ago Date Table, Three Day Offset Date Table"

	annotation DisplayFolder = "System Tables"

	annotation RefreshPolicy = "Dynamically generated based on CALENDARIO table data range. No manual refresh required. Proposed – pending Loro Piana validation."

