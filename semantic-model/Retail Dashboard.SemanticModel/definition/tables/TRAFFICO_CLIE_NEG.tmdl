				in
				        #"Removed Other Columns"

		annotation Description = "Import partition for store traffic master data. Loads all store traffic records without date filtering."

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

	annotation Description = "Store traffic dimension tracking customer visits to stores. Contains daily customer count data at the store level. Used for traffic analysis, conversion rate calculations, footfall trends, and store performance evaluation. Links to stores and sales data to enable traffic-to-sales conversion analysis. Grain: one row per store per day. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Store Traffic, Customer Traffic, Footfall, Customer Visits, Store Visits, Traffic Count"

	annotation DisplayFolder = "Store Master"

	annotation RefreshPolicy = "Daily or as data is collected. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana Retail Operations Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "Store: LP001, Date: 2026-08-07, Customers: 150"

	annotation 'Common Questions' = "What is the daily footfall for each store? How does traffic vary by day of week? What is the conversion rate by store? How does traffic correlate with sales? Which stores have the highest traffic?"

	annotation 'Related Objects' = "STORES, SCONTRINI, OPERATORI_NEGOZI, TARGET"
