table RLS_STORE_OPS_TABLE
	isHidden
	lineageTag: 3f880bbe-2a63-4e47-9035-b3dcd978fbab

	column UserRole
		dataType: string
		isHidden
		lineageTag: 6e4ed8ce-fd1b-46d4-a2db-c74bd1fed4a1
		summarizeBy: none
		sourceColumn: Role

		annotation SummarizationSetBy = Automatic

		annotation Description = "Role or job function of the user within store operations (e.g., 'Store Ops', 'Area Manager', 'Regional Ops'). Used for role-based security grouping. Proposed – pending Loro Piana validation on role values and definitions."

		annotation Synonyms = "Role, Job Function, Operations Role, User Role"

		annotation DisplayFolder = "User Details"

		annotation 'Example Values' = "Store Ops, Area Manager, Regional Ops, Operations Director"

		annotation 'Common Questions' = "What roles have access to operations data? Which users are in the Store Ops role?"

		annotation 'Related Objects' = "RLS roles"

	column UserFirstName
		dataType: string
		isHidden
