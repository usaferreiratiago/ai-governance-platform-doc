		summarizeBy: none
		sourceColumn: Name

		annotation SummarizationSetBy = Automatic

		annotation Description = "First name of the store operations user (e.g., 'Maria', 'Giuseppe'). Used for identification and reporting. Proposed – pending Loro Piana validation on privacy requirements."

		annotation Synonyms = "First Name, Given Name, User Name"

		annotation DisplayFolder = "User Details"

		annotation 'Example Values' = "Maria, Giuseppe, John, Chiara, Andrea"

		annotation 'Common Questions' = "What is the first name of the operations user? How do I identify users by name?"

		annotation 'Related Objects' = "RLS roles"

