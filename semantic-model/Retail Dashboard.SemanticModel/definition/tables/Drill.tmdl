	partition 'Business Hierarchy Selection' = calculated
		mode: import
		source =
				{
				    ("Macro Category", NAMEOF('BUSINESS'[Macro Category]), 1),
				    ("Macrobusiness", NAMEOF('BUSINESS'[Macrobusiness Description]), 0),
				    ("Business", NAMEOF('BUSINESS'[Business Description]), 2)
				}

		annotation Description = "Calculated partition that unions three levels of the business hierarchy from the BUSINESS table: Macro Category (highest level), Macrobusiness (middle level), and Business (most granular level). This creates a unified selection dimension for dynamic drill-down and filtering across all hierarchy levels. The sort order is: Macrobusiness (0), Macro Category (1), Business (2)."

	annotation PBI_Id = 5c72e271385a403ab7850e1a8eb28810

	annotation Description = "Calculated dimension that unions three levels of the business hierarchy (Macro Category → Macrobusiness → Business) into a single selection list for dynamic drill-down and filtering. Enables users to select any level of the business hierarchy from one unified field for analysis and visualization. Grain: one row per unique business hierarchy value across all levels. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Business Hierarchy Drill, Drill Dimension, Hierarchy Selection, Business Level Selection, Unified Business Hierarchy"

	annotation DisplayFolder = "Product Master"

	annotation RefreshPolicy = "Weekly on Sundays at 00:00 UTC; data latency ≤ 48 hours. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana Commercial Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "Macro Category: Ready-to-Wear, Macrobusiness: Knitwear, Business: Cashmere Sweaters"

	annotation 'Common Questions' = "How do I drill down from Macro Category to Business? What are the different hierarchy levels available? How do I filter by Business hierarchy? What is the difference between Macro Category, Macrobusiness, and Business?"

	annotation 'Related Objects' = "BUSINESS.'Business Description', BUSINESS.'Macrobusiness Description', BUSINESS.'Macro Category', CLASSE_PRODOTTO, ARTICOLI"
