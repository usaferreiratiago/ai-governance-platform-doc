	partition 'Local Date Table - Store Closure' = calculated
		mode: import
		source = Calendar(Date(Year(MIN('NEGOZI'[DATA_CHIUSURA])), 1, 1), Date(Year(MAX('NEGOZI'[DATA_CHIUSURA])), 12, 31))

		annotation Description = "Auto-generated local date table partition. Date range is dynamically calculated from the NEGOZI (Stores) table's DATA_CHIUSURA (closure date) column, spanning full years from the minimum to maximum closure year. This ensures the date table covers all store closure dates referenced in the model. Used for store closure analysis, active store tracking, lease expiration monitoring, and store network planning. Proposed – pending Loro Piana validation on data source and date range logic."

	annotation __PBI_LocalDateTable = true

	annotation Description = "Power BI auto-generated local date table providing a continuous date range for store closure date-based time intelligence calculations. This hidden table serves as the foundation for date-based relationships and time intelligence functions based on the DATA_CHIUSURA (closure date) field from the NEGOZI (Stores) table. Contains standard date attributes including Year, Quarter, Month, and Day, with a default 'Date Hierarchy' for drill-down analysis. Date range is dynamically derived from the 'NEGOZI' table's DATA_CHIUSURA column (full years only). Used for store closure analysis, active store tracking, lease expiration monitoring, and store network planning. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Local Date Table, Date Dimension, Time Dimension, Calendar Table, Date Hierarchy, Store Closure Date Table, Closure Date Table"

	annotation DisplayFolder = "System Tables"

	annotation RefreshPolicy = "Dynamically generated based on NEGOZI table data range. No manual refresh required. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana BI Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "Date: 2024-01-01, Year: 2024, Quarter: Qtr 1, Month: January, Day: 1"

	annotation 'Common Questions' = "What is the store closure date range? How do I use the date hierarchy for closure analysis? How do I filter by closure year, quarter, or month? What is the store closure date table used for?"

	annotation 'Related Objects' = "NEGOZI, STORES, SCONTRINI, TARGET"

	annotation __PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
