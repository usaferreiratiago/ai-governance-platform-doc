		annotation TemplateId = DateHierarchy

		annotation Description = "Default time hierarchy allowing drill-down from Year → Quarter → Month → Day for variation date analysis. Provides intuitive navigation for sales variation tracking and change analysis. Proposed – pending Loro Piana validation."

		annotation 'Common Questions' = "How do I drill down from variation year to variation month? How do I expand variation quarterly data? What is the date hierarchy structure for variation analysis?"

	partition 'Local Date Table - Variation Date' = calculated
		mode: import
		source = Calendar(Date(Year(MIN('SCONTRINI'[DATA_VARIAZ])), 1, 1), Date(Year(MAX('SCONTRINI'[DATA_VARIAZ])), 12, 31))

		annotation Description = "Auto-generated local date table partition. Date range is dynamically calculated from the SCONTRINI table's DATA_VARIAZ (variation date) column, spanning full years from the minimum to maximum variation year. This ensures the date table covers all variation dates referenced in the model. Used for variation analysis and change tracking. Proposed – pending Loro Piana validation on the business meaning of DATA_VARIAZ and its data source."

	annotation __PBI_LocalDateTable = true

	annotation Description = "Power BI auto-generated local date table providing a continuous date range for variation date-based time intelligence calculations. This hidden table serves as the foundation for date-based relationships and time intelligence functions based on the DATA_VARIAZ (variation date) field from the SCONTRINI (sales transactions) table. Contains standard date attributes including Year, Quarter, Month, and Day, with a default 'Date Hierarchy' for drill-down analysis. Date range is dynamically derived from the 'SCONTRINI' table's DATA_VARIAZ column (full years only). Used for variation analysis, change tracking, and date-based comparisons of sales variations. Proposed – pending Loro Piana validation on the specific business meaning of DATA_VARIAZ (variation date)."

	annotation Synonyms = "Local Date Table, Date Dimension, Time Dimension, Calendar Table, Date Hierarchy, Variation Date Table, Sales Variation Date"

	annotation DisplayFolder = "System Tables"

	annotation RefreshPolicy = "Dynamically generated based on SCONTRINI table data range. No manual refresh required. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana BI Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "Date: 2024-01-01, Year: 2024, Quarter: Qtr 1, Month: January, Day: 1"

	annotation 'Common Questions' = "What is the variation date range? How do I use the date hierarchy for variation analysis? How do I filter by variation year, quarter, or month? What is the variation date table used for?"

	annotation 'Related Objects' = "SCONTRINI, CALENDARIO, DateTableTemplate"

	annotation __PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
