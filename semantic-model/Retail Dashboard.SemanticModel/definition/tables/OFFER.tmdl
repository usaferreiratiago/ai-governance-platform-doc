table OFFER
	lineageTag: 166c4e85-3ca6-4651-939f-3cfea76145ca

	column OfferCode
		dataType: string
		lineageTag: 5ff0a978-f54a-4e5f-97c2-6002354346ed
		summarizeBy: none
		sourceColumn: Offer Code

		annotation SummarizationSetBy = Automatic

		annotation Description = "Unique code identifying a specific offer (e.g., 'BAG_PROMO', 'SS24_BASIC'). Used to link product-color variants to specific offers. Proposed – pending Loro Piana validation."

		annotation Synonyms = "Offer Code, Offer ID, Offer Identifier, Promo Code"

		annotation DisplayFolder = "Offer Details"

		annotation 'Example Values' = "BAG_PROMO, SS24_BASIC, FW24_EXCLUSIVE, SHOE_CLEARANCE"

		annotation 'Common Questions' = "What is the offer code for the current promotion? How many products are in each offer? Which offer has the highest sales?"

		annotation 'Related Objects' = "ARTICOLI_COLORE"

	column MacroOfferCode
		dataType: string
		lineageTag: 60af81e6-dadf-4048-9097-dbe898592088
		summarizeBy: none
		sourceColumn: Macro Offer Code

		annotation SummarizationSetBy = Automatic

		annotation Description = "Code identifying the macro offer grouping (e.g., 'PROMOTIONS', 'CORE_COLLECTION', 'EXCLUSIVE'). Used to group offers for higher-level analysis. Proposed – pending Loro Piana validation."

		annotation Synonyms = "Macro Offer ID, Offer Group Code, Campaign Code, Offer Category Code"

		annotation DisplayFolder = "Offer Details"

		annotation 'Example Values' = "PROMOTIONS, CORE_COLLECTION, EXCLUSIVE, SEASONAL, CLEARANCE"

		annotation 'Common Questions' = "What are the macro offer groups? How many offers are in each macro offer?"

		annotation 'Related Objects' = "ARTICOLI_COLORE"

	column MacroOfferDescription
		dataType: string
		lineageTag: e82f7d8e-d985-470a-803e-67483346f2b1
		summarizeBy: none
		sourceColumn: Macro Offer

		annotation SummarizationSetBy = Automatic

		annotation Description = "Business-friendly description of the macro offer (e.g., 'Promotions', 'Core Collection'). Use for reporting and labels. Note: Hardcoded replacement in M code: 'PERSONALIZATION' → 'PERSONALIZ'. Proposed – pending Loro Piana validation."

		annotation Synonyms = "Macro Offer Name, Offer Group Name, Campaign Name, Offer Category"

		annotation DisplayFolder = "Offer Details"

		annotation 'Example Values' = "Promotions, Core Collection, Exclusive, Seasonal, Clearance"

		annotation 'Common Questions' = "What is the macro offer name for code PROMOTIONS? How do macro offers perform?"

		annotation 'Related Objects' = "ARTICOLI_COLORE"

