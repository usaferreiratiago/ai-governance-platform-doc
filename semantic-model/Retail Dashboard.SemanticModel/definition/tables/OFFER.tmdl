	column OfferName
		dataType: string
		lineageTag: 6d5c96bc-da87-4985-a01e-ec68d3fbb1ff
		summarizeBy: none
		sourceColumn: Offer
		sortByColumn: OfferSortOrder

		annotation SummarizationSetBy = Automatic

		annotation Description = "Business-friendly name of the offer. Note: Hardcoded logic in M code: 'nd' values are replaced with 'OTHER'. Proposed – pending Loro Piana validation."

		annotation Synonyms = "Offer Name, Offer Description, Offer Title"

		annotation DisplayFolder = "Offer Details"

		annotation 'Example Values' = "BAG_PROMO, SS24_BASIC, FW24_EXCLUSIVE"

		annotation 'Common Questions' = "What is the offer name? Which offers are available?"

		annotation 'Related Objects' = "ARTICOLI_COLORE"

	partition OFFER = m
		mode: import
		source =
				let
				        Source = PowerPlatform.Dataflows(null),
				        Workspaces = Source{[Id="Workspaces"]}[Data],
				        WS = Workspaces{[workspaceId="63075e43-ec19-4090-b204-854337b4b0d5"]}[Data],
				        DF = WS{[dataflowId="9839110f-89f4-42a8-86a3-0da4749f930e"]}[Data],
				        OFFER_ = DF{[entity="OFFER",version=""]}[Data],
				        // Select base columns
				        #"Removed Other Columns" = Table.SelectColumns(OFFER_,{"Offer Code", "Offer", "Macro Offer Code", "Macro Offer", "Offer Ord", "Macro Offer Ord"}),
				        // Add display labels with Δ vs LY
				        Personalizzato1 = Table.AddColumn(#"Removed Other Columns", "Offer Label", each [Offer] & Character.FromNumber(10) & "Δ vs LY"),
				        Personalizzato2 = Table.AddColumn(Personalizzato1, "Macro Offer Label", each [Macro Offer] & Character.FromNumber(10) & "Δ vs LY"),
				        // Replace 'nd' with 'OTHER' for Offer
				        #"Added Conditional Column" = Table.AddColumn(Personalizzato2, "Custom", each if [Offer] = "nd" then "OTHER" else [Offer], type text),
				        #"Renamed Columns" = Table.RenameColumns(#"Added Conditional Column",{{"Custom", "Offer New"}}),
				        // Replace 'nd' with 'OTHER' for Macro Offer
				        #"Replaced Value" = Table.ReplaceValue(#"Renamed Columns","nd","OTHER",Replacer.ReplaceText,{"Macro Offer"}),
				        // Swap Offer with Offer New (contains 'OTHER' replacement)
				        #"Renamed Columns1" = Table.RenameColumns(#"Replaced Value",{{"Offer", "Offer Tmp"}, {"Offer New", "Offer"}}),
				        #"Removed Columns" = Table.RemoveColumns(#"Renamed Columns1",{"Offer Tmp"}),
				        // Hardcoded sort order change: 8 → 7
				        #"Replaced Value1" = Table.ReplaceValue(#"Removed Columns",8,7,Replacer.ReplaceValue,{"Offer Ord"}),
				        // Hardcoded text replacement: PERSONALIZATION → PERSONALIZ
				        #"Replaced Value2" = Table.ReplaceValue(#"Replaced Value1","PERSONALIZATION","PERSONALIZ",Replacer.ReplaceText,{"Macro Offer"}),
				        #"Replaced Value3" = Table.ReplaceValue(#"Replaced Value2","PERSONALIZATION","PERSONALIZ",Replacer.ReplaceText,{"Offer"})
				in
				        #"Replaced Value3"

		annotation Description = "Import partition for offer master data. Performs multiple hardcoded transformations: (1) Adds 'Δ vs LY' display labels, (2) Replaces 'nd' with 'OTHER' in Offer and Macro Offer, (3) Changes Offer Ord value 8→7, (4) Replaces 'PERSONALIZATION' with 'PERSONALIZ'. Proposed – pending Loro Piana validation on all business rules."

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

	annotation Description = "Offer hierarchy dimension for the luxury retail assortment. Defines product offer classifications at two levels: Offer (granular) and Macro Offer (grouped). Used for promotional analysis, offer performance tracking, and campaign reporting. Includes display labels with variance indicators and hardcoded business logic for offer grouping. Grain: one row per offer code. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Offer, Offer Hierarchy, Promotional Offer, Offer Classification, Campaign Offer"

	annotation DisplayFolder = "Product Master"

	annotation RefreshPolicy = "Weekly on Sundays at 00:00 UTC; data latency ≤ 48 hours. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana Commercial Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "Offer: BAG_PROMO, Macro Offer: PROMOTIONS; Offer: SS24_BASIC, Macro Offer: CORE_COLLECTION"

	annotation 'Common Questions' = "What offers are available? How do offers perform by sales? Which macro offer has the highest performance? How do offers compare within each macro offer?"

	annotation 'Related Objects' = "ARTICOLI_COLORE, SCONTRINI, CLASSE_PRODOTTO, TARGET"
