		annotation Synonyms = "Offer Label, Display Offer, Offer with Variance"

		annotation DisplayFolder = "Offer Details"

		annotation 'Example Values' = "BAG_PROMO Δ vs LY, SS24_BASIC Δ vs LY"

		annotation 'Common Questions' = "What is the display label for this offer?"

	column MacroOfferDisplayLabel
