	partition 'Local Date Table - Customer Registration' = calculated
		mode: import
		source = Calendar(Date(Year(MIN('CUSTOMER'[Data Iscrizione])), 1, 1), Date(Year(MAX('CUSTOMER'[Data Iscrizione])), 12, 31))

		annotation Description = "Auto-generated local date table partition. Date range is dynamically calculated from the CUSTOMER table's Data Iscrizione (registration date) column, spanning full years from the minimum to maximum registration year. This ensures the date table covers all customer registration dates referenced in the model. Used for customer acquisition analysis, new client tracking, cohort analysis, and registration trend reporting. Proposed – pending Loro Piana validation on data source and date range logic."

	annotation __PBI_LocalDateTable = true

	annotation Description = "Power BI auto-generated local date table providing a continuous date range for customer registration date-based time intelligence calculations. This hidden table serves as the foundation for date-based relationships and time intelligence functions based on the Data Iscrizione (registration date) field from the CUSTOMER table. Contains standard date attributes including Year, Quarter, Month, and Day, with a default 'Date Hierarchy' for drill-down analysis. Date range is dynamically derived from the 'CUSTOMER' table's Data Iscrizione column (full years only). Used for customer acquisition analysis, new client tracking, cohort analysis, and registration trend reporting. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Local Date Table, Date Dimension, Time Dimension, Calendar Table, Date Hierarchy, Customer Registration Date Table, Acquisition Date Table"

	annotation DisplayFolder = "System Tables"

	annotation RefreshPolicy = "Dynamically generated based on CUSTOMER table data range. No manual refresh required. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana BI Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "Date: 2024-01-01, Year: 2024, Quarter: Qtr 1, Month: January, Day: 1"

	annotation 'Common Questions' = "What is the customer registration date range of the model? How do I use the date hierarchy for customer acquisition analysis? How do I filter by registration year, quarter, or month? What is the customer registration date table used for?"

	annotation 'Related Objects' = "CUSTOMER, ACTIVE_CUSTOMER_MONTH, SCONTRINI, TARGET"

	annotation __PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
