	partition 'Local Date Table - Ticket Summary' = calculated
		mode: import
		source = Calendar(Date(Year(MIN('SCONTRINI_TEMP'[Date])), 1, 1), Date(Year(MAX('SCONTRINI_TEMP'[Date])), 12, 31))

		annotation Description = "Auto-generated local date table partition. Date range is dynamically calculated from the SCONTRINI_TEMP table's Date column, spanning full years from the minimum to maximum ticket summary year. This ensures the date table covers all ticket summary dates referenced in the model. Used for ticket-level category analysis, basket diversity tracking, per-ticket category count metrics, and transaction-level reporting. Proposed – pending Loro Piana validation on data source and date range logic."

	annotation __PBI_LocalDateTable = true

	annotation Description = "Power BI auto-generated local date table providing a continuous date range for ticket summary time intelligence calculations. This hidden table serves as the foundation for date-based relationships and time intelligence functions based on the Date field from the SCONTRINI_TEMP (Ticket Summary) table. Contains standard date attributes including Year, Quarter, Month, and Day, with a default 'Date Hierarchy' for drill-down analysis. Date range is dynamically derived from the 'SCONTRINI_TEMP' table's Date column (full years only). Used for ticket-level category analysis, basket diversity tracking, per-ticket category count metrics, and transaction-level reporting. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Local Date Table, Date Dimension, Time Dimension, Calendar Table, Date Hierarchy, Ticket Summary Date Table, Basket Analysis Date Table"

	annotation DisplayFolder = "System Tables"

	annotation RefreshPolicy = "Dynamically generated based on SCONTRINI_TEMP table data range. No manual refresh required. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana BI Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "Date: 2024-01-01, Year: 2024, Quarter: Qtr 1, Month: January, Day: 1"

	annotation 'Common Questions' = "What is the ticket summary date range? How do I use the date hierarchy for basket analysis? How do I filter by ticket date year, quarter, or month? What is the ticket summary date table used for?"

	annotation 'Related Objects' = "SCONTRINI_TEMP, SCONTRINI, CLASSE_PRODOTTO, DateTableTemplate"

	annotation __PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table