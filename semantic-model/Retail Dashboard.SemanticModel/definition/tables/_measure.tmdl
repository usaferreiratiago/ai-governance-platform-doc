	measure 'Net Sales - NO Shoes YTD' = ```
			var giorno_scelto = _measure[Selected Day]
			var anno = YEAR(giorno_scelto)
			var mese = MONTH(giorno_scelto)
			var giorno = DAY(giorno_scelto)
			var net_sales = [Net Sales YTD]
			var no_shoes_ytd = CALCULATE([Net Sales Euro Current Exchange],  year(CALENDARIO[Date]) = anno , CALENDARIO[Date] <= giorno_scelto,
			(BUSINESS[Business Description] = "MEN - SHOES" || BUSINESS[Business Description] = "KIDS - SHOES" ||  BUSINESS[Business Description] = "WOMEN - SHOES" || BUSINESS[Business Description] = "UNISEX - SHOES"))
			
			return net_sales - no_shoes_ytd
			
			```
