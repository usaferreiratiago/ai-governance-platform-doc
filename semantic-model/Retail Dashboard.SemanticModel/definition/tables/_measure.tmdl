	measure 'Ticket Number LYWTD' = ```
			
			var giorno_scelto = _measure[Selected Day] 
			var date_ly = CALCULATE(SELECTEDVALUE(CALENDARIO[DATA_WAGO_DTA]),CALENDARIO[Date] = giorno_scelto)
			var anno = CALCULATE(SELECTEDVALUE(CALENDARIO[Fiscal Year]),CALENDARIO[Date] = date_ly)
			var settimana = CALCULATE(SELECTEDVALUE(CALENDARIO[Fiscal Week]),CALENDARIO[Date] = date_ly)
			var calcolo = CALCULATE(DISTINCTCOUNT(SCONTRINI[Ticket ID]), 
									--year(CALENDARIO[Date]) = anno ,
			                        (CALENDARIO[Fiscal Year]) = anno,
									CALENDARIO[Fiscal Week] = settimana,
			                        CALENDARIO[Date]<= date_ly,
								    OR(SCONTRINI[Ticket Type] = "SBMST", SCONTRINI[Ticket Type] = "SBVEN"), 
								    SCONTRINI[Ticket Row Type] = "VEN"
									)
			
			return calcolo
			```
		formatString: 0
		displayFolder: Ticket Number\LY
		lineageTag: 6a9eac7f-6832-464c-9eb4-5a15352bf723

	measure 'Ticket Number LYMTD' = ```
			
			var giorno_scelto = _measure[Selected Day]
			var anno = YEAR(giorno_scelto)-1
			var mese = MONTH(giorno_scelto)
			var giorno = DAY(giorno_scelto)
			var calcolo = CALCULATE(DISTINCTCOUNT(SCONTRINI[Ticket ID]),
			                        year(CALENDARIO[Date]) = anno ,
			                        month(CALENDARIO[Date]) = mese, 
			                        day(CALENDARIO[Date]) <= giorno,
			                        OR(SCONTRINI[Ticket Type] = "SBMST", SCONTRINI[Ticket Type] = "SBVEN"), 
			                        SCONTRINI[Ticket Row Type] = "VEN"
			                        )
			
			return calcolo
			```
		formatString: 0
		displayFolder: Ticket Number\LY
		lineageTag: 1143eeee-e2b9-4dc0-bb4a-975148758c57

	measure 'Ticket Number LYTD' = ```
			
			var giorno_scelto = _measure[Selected Day]
			var date_ly = CALCULATE(SELECTEDVALUE(CALENDARIO[Date LY]),CALENDARIO[Date] = giorno_scelto)
			
			var calcolo = CALCULATE(DISTINCTCOUNT(SCONTRINI[Ticket ID]),
			                        CALENDARIO[ANNO_COD] =  CONVERT(YEAR(date_ly),STRING),
			                        CALENDARIO[Date]<= date_ly, 
			                        OR(SCONTRINI[Ticket Type] = "SBMST", SCONTRINI[Ticket Type] = "SBVEN"),
			                        SCONTRINI[Ticket Row Type] = "VEN"
			                        )
			
			return
			calcolo
			```
		formatString: 0
