	measure 'Target Value Exchange Fiscal' = ```
			
			
			VAR currnecy= SELECTEDVALUE('Currency Selector'[Currency])
			
			RETURN
			SWITCH(currnecy,
			        "Local", SUM(TARGET[Target Local Value]),
			        "Euro",CALCULATE(
			    sumx(TARGET, 
			        DIVIDE(TARGET[Target Local Value], 
			                RELATED('TARGET EXCHANGE'[Exchange Revised]))), 
			        USERELATIONSHIP(TARGET[KEY_ANNOFISC_CURR],'TARGET EXCHANGE'[KEY_ANNO_CURR])
			        )
			    )
			```
		lineageTag: fda44e5e-e57b-43e3-b491-5fd6a39a1fd8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Sales Euro Target Exchange Fiscal' = ```
			
			
			VAR currnecy= SELECTEDVALUE('Currency Selector'[Currency])
			
			RETURN
			SWITCH(currnecy,
			        "Local", SUM(SCONTRINI[Net Sales Ccy]),
			        "Euro",CALCULATE(
			    sumx(SCONTRINI, 
					DIVIDE(SCONTRINI[Net Sales Ccy], 
					RELATED('TARGET EXCHANGE'[Exchange Revised]))), 
			    USERELATIONSHIP(TARGET[KEY_ANNOFISC_CURR],'TARGET EXCHANGE'[KEY_ANNO_CURR])
			        )
			    )
			```
