	measure Achieved = ```
			
			
			var calcolo = [Net Sales MTD]
			
			return "Achieved: " & coalesce(
			    if(ABS(calcolo)<=10^3,format(calcolo,"#,##0.00"),
			    if(ABS(calcolo)<=10^6,format(calcolo,"#,##0,.00K"), 
			    if(ABS(calcolo)<=10^9,format(calcolo,"#,##0,,.00Mln"),
			    format(calcolo,"#,##0,,,.00Bn")))),"-") 
			```
