table _measure
	lineageTag: a09f9fc5-ae9a-4dd8-842f-cc12b2d0f05e

	measure _clients =
			
			DISTINCTCOUNT(SCONTRINI[Clients])
		formatString: #,0
		displayFolder: Clients
		lineageTag: a5e56cec-5796-4f2d-bdfd-9d1fb7cd4a7e

		changedProperty = FormatString

	measure 'Net Sales Yesterday' =
			
			var giorno_scelto = _measure[Selected Day]
			var calcolo = CALCULATE(SUM(SCONTRINI[Net Sales Ccy]),CALENDARIO[Date] = giorno_scelto)
			return calcolo
		formatString: #,0.00
		displayFolder: Net Sales\CY
		lineageTag: 78451fc6-d4f0-42a4-8101-7de3df2dcc7c

		changedProperty = FormatString

	measure 'Unit Yesterday' =
			
