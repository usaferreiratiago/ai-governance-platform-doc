	measure 'SHOES MONOBUYERS clients MTD' =
			
			var giorno_scelto = _measure[Selected Day]
			var anno = YEAR(giorno_scelto)
			var mese = MONTH(giorno_scelto)
			var giorno = DAY(giorno_scelto)
			var calcolo = CALCULATE(_measure[_CLI_MONO],  year(CALENDARIO[Date]) = anno ,month(CALENDARIO[Date]) = mese, day(CALENDARIO[Date]) <= giorno)
			
			return calcolo
