	measure 'Net Sales YTD' =
			
			/*var giorno_scelto = _measure[Selected Day]
			var calcolo = TOTALYTD(SUM(SCONTRINI[Net Sales Ccy]),
			                        CALENDARIO[Date].[Date],
			                        AND( CALENDARIO[ANNO_COD] = CONVERT(YEAR(giorno_scelto),STRING),CALENDARIO[Date] <= giorno_scelto))
			return calcolo*/
			var giorno_scelto = _measure[Selected Day]
			var anno = YEAR(giorno_scelto)
			var mese = MONTH(giorno_scelto)
			var giorno = DAY(giorno_scelto)
			var calcolo = CALCULATE([Net Sales Euro Current Exchange],  year(CALENDARIO[Date]) = anno , CALENDARIO[Date] <= giorno_scelto)
			
			return calcolo
		displayFolder: Net Sales\CY
		lineageTag: 92741ebc-00b1-4b56-9793-bc703a3dedfb

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Sales MTD' =
			
			var giorno_scelto = _measure[Selected Day]
			var anno = YEAR(giorno_scelto)
			var mese = MONTH(giorno_scelto)
			var giorno = DAY(giorno_scelto)
			var calcolo = CALCULATE([Net Sales Euro Current Exchange],  year(CALENDARIO[Date]) = anno ,month(CALENDARIO[Date]) = mese, day(CALENDARIO[Date]) <= giorno)
			
			return calcolo
		formatString: #,0.00
		displayFolder: Net Sales\CY
		lineageTag: b744f0d8-f900-4626-baaa-0aae899e93bd

		changedProperty = FormatString

	measure 'Net Sales WTD' = ```
			
			var giorno_scelto = _measure[Selected Day]
			var anno = CALCULATE(SELECTEDVALUE(CALENDARIO[Fiscal Year]),CALENDARIO[Date] = giorno_scelto)
			var settimana = CALCULATE(SELECTEDVALUE(CALENDARIO[Fiscal Week]),CALENDARIO[Date] = giorno_scelto)
			var calcolo = CALCULATE([Net Sales Euro Current Exchange Fiscal],  
			                        --year(CALENDARIO[Date]) = anno,
			                        (CALENDARIO[Fiscal Year]) = anno, 
			                        CALENDARIO[Fiscal Week] = settimana,
			                        CALENDARIO[Date] <= giorno_scelto)
			
			return calcolo
			```
		displayFolder: Net Sales\CY
		lineageTag: 3c65816b-8594-4dcd-827b-f890b28232ab

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Sales LYTD' =
			
			var giorno_scelto = _measure[Selected Day]
			var date_ly = CALCULATE(SELECTEDVALUE(CALENDARIO[Date LY]),CALENDARIO[Date] = giorno_scelto)
			var calcolo = CALCULATE([Net Sales Euro Current Same Date Exchange], CALENDARIO[ANNO_COD]= CONVERT(YEAR(date_ly),STRING), CALENDARIO[Date]<= date_ly)
			
			return calcolo
		formatString: #,0.00
		displayFolder: Net Sales\LY
		lineageTag: 6c3aae10-863e-4aa6-8c3d-a1bd40115d13

		changedProperty = FormatString

	measure 'Net Sales Yesterday LY' =
			
			var giorno_scelto = _measure[Selected Day]
			var date_ly = CALCULATE(SELECTEDVALUE(CALENDARIO[DATA_WAGO_DTA]),CALENDARIO[Date] = giorno_scelto)
			var calcolo = CALCULATE(SUM(SCONTRINI[Net Sales Ccy]),CALENDARIO[Date] = date_ly)
			
			return calcolo
		formatString: #,0.00
		displayFolder: Net Sales\LY
		lineageTag: e82a08a5-b7a9-4627-8719-62544caffa03

		changedProperty = FormatString

	measure 'Net Sales LYWTD' =
			
			var giorno_scelto = _measure[Selected Day]
			var date_ly = CALCULATE(SELECTEDVALUE(CALENDARIO[DATA_WAGO_DTA]),CALENDARIO[Date] = giorno_scelto)
			var anno = CALCULATE(SELECTEDVALUE(CALENDARIO[Fiscal Year]),CALENDARIO[Date] = date_ly)
			var settimana = CALCULATE(SELECTEDVALUE(CALENDARIO[Fiscal Week]),CALENDARIO[Date] = date_ly)
			var calcolo = CALCULATE([Net Sales Euro Current Same Date Exchange Fiscal],
			                        --year(CALENDARIO[Date]) = anno,
			                        (CALENDARIO[Fiscal Year]) = anno,
			                        CALENDARIO[Fiscal Week] = settimana,
			                        CALENDARIO[Date]<= date_ly
			                        )
			
			return calcolo
		formatString: #,0.00
		displayFolder: Net Sales\LY
		lineageTag: 334bb6ed-41b1-4a7a-bf3a-00eb5b6a40e7

		changedProperty = FormatString

	measure 'Net Sales LYMTD' = ```
			
			var giorno_scelto = _measure[Selected Day]
			var anno = YEAR(giorno_scelto)-1
			var mese = MONTH(giorno_scelto)
			var giorno = DAY(giorno_scelto)
			var calcolo = CALCULATE([Net Sales Euro Current Same Date Exchange],  
			                        year(CALENDARIO[Date]) = anno ,
			                        month(CALENDARIO[Date]) = mese, 
			                        day(CALENDARIO[Date]) <= giorno
			                        )
			
			return calcolo
			```
		formatString: #,0.00
		displayFolder: Net Sales\LY
		lineageTag: ffe4f06b-650d-4514-83ae-e06d2b9c4a90

		changedProperty = FormatString

	measure 'Net Sales WTD vs LY %' =
			
			VAR NUMERATORE = [Net Sales WTD for delta] - [Net Sales LYWTD for delta]
			VAR CALCOLO = DIVIDE(NUMERATORE,[Net Sales LYWTD for delta])
			RETURN
			CALCOLO
		formatString: #,0.00%;-#,0.00%;#,0.00%
		displayFolder: Net Sales\Delta %
