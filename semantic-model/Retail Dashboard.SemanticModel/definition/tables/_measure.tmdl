	measure '_Titolo Drill Through 2' = ```
			
			Var res = IF(ISFILTERED(NEGOZI[Store Description]), MAX(NEGOZI[Store Description])&" ", 
			             IF(ISFILTERED(NAZIONI[Country Description]), MAX(NAZIONI[Country Description])&" ",
			             IF(ISFILTERED(AREA_MANAGER[Area Manager Description]), MAX(AREA_MANAGER[Area Manager Description])&" ",
			              IF(DISTINCTCOUNT(NEGOZI[Logistic Area]) < 7, CONCATENATEX(NEGOZI, [Logistic Area], "-")&" ","Worldwide")
			             ) ) )
			VAR grandezza= SELECTEDVALUE('KPI Selector'[KPI])
			var _sommaperiod = [_TY Retail Equation]
			var _sommafree = [_MeasureSelector - FreePeriod]
			var _somma = IF(
			                HASONEFILTER('Period Selector'[Period]),
			                _sommaperiod,
			                _sommafree
			)
			var _format = 
			   IF(grandezza in {"Conversion Rate","Cross Selling", "Cross Selling RTW", "High Ticket Share"},
			   format(_somma,"0.00%"),
			   if(grandezza="Net Sales",
			   coalesce(
			    if(ABS(_somma)<=10^3,format(_somma,"#,##0.00"),
			    if(ABS(_somma)<=10^6,format(_somma,"#,##0,.00K"), 
			    if(ABS(_somma)<=10^9,format(_somma,"#,##0,,.00Mln"),
			    format(_somma,"#,##0,,,.00Bn")))),"-"),
			    format(_somma,"#,0")
			   ))
			Return IF([Check Currency Consistency V2]=1, res & "(Total This Year: " & _format & ")", res)
			```
		lineageTag: ab393ea8-a2d5-4156-9ea3-dd0eacdb2295

