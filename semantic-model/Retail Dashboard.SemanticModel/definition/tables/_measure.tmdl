	measure 'New ACQUIRED Clients LYTD' =
			
			var giorno_scelto = _measure[Selected Day]
			var calcolo = CALCULATE( [Clients LYTD],
										FILTER(ACTIVE_CUSTOMER_MONTH, AND( ACTIVE_CUSTOMER_MONTH[ANNO_COD] = CONVERT(YEAR(giorno_scelto)-1,STRING), AND( ACTIVE_CUSTOMER_MONTH[MESE_COD] = CONVERT(MONTH(giorno_scelto),STRING), ACTIVE_CUSTOMER_MONTH[YEAR_CUST_TYPE_DES] = "NEW-ACQUIRED")))
										)
			
