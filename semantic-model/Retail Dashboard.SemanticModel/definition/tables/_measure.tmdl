				        "Quantity","#,0",
				        "Ticket","#,0",
				        "Conversion Rate","0.00%",
				        "UPT","#,0.00",
				        "Avg Ticket","#,0.00",
				        "Average Price","#,0.00",
				        "Cross Selling", "0.00%", 
				        "Cross Selling RTW", "0.00%",
				        "High Ticket #", "#,0",
				        "High Ticket Share (#)", "0.00%"
				    )
				```

