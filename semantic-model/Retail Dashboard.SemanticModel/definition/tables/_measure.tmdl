	measure '_Titolo Drill Through - liv 1' = ```
			
			Var res = IF(ISFILTERED(NEGOZI[Store Description]), MAX(NEGOZI[Store Description])&" ", 
			             IF(ISFILTERED(NAZIONI[Country Description]), MAX(NAZIONI[Country Description])&" ",
			             IF(ISFILTERED(AREA_MANAGER[Area Manager Description]), MAX(AREA_MANAGER[Area Manager Description])&" ",
			              IF(DISTINCTCOUNT(GERARCHIA_AREA[Area Description]) < 7, CONCATENATEX(GERARCHIA_AREA, [Area Description], "-")&" ","Worldwide")
			             ) ) )
			VAR grandezza= SELECTEDVALUE('KPI Selector'[KPI])
			var _sommaperiod = [_TY Retail Equation]
			var _sommafree = [_MeasureSelector - FreePeriod]
			var _somma = IF(
			                HASONEFILTER('Period Selector'[Period]),
			                _sommaperiod,
			                _sommafree
			)
			var _format = 
			   IF(grandezza in {"Conversion Rate","Cross Selling", "Cross Selling RTW", "High Ticket Share (#)"},
			   format(_somma,"0.00%"),
			   if(grandezza="Net Sales",
			   coalesce(
			    if(ABS(_somma)<=10^3,format(_somma,"#,##0.00"),
			    if(ABS(_somma)<=10^6,format(_somma,"#,##0,.00K"), 
			    if(ABS(_somma)<=10^9,format(_somma,"#,##0,,.00Mln"),
			    format(_somma,"#,##0,,,.00Bn")))),"-"),
			    format(_somma,"#,0")
			   ))
			Return IF([Check Currency Consistency V2]=1, res & "(Total This Year: " & _format & ")", res)
			```
		lineageTag: 3d6f13dc-6358-4c40-a516-6cd99c9303a8

	measure Taglio_Trend_Week = ```
			
			var data_massima = [Max date tooltip]
			var data_minima = [StartDate]
			var massimo = CALCULATE(MAX(CALENDARIO[Year_Month_Week_Fiscal]),
			            CALENDARIO[Date] <= data_massima, 
			            CALENDARIO[Date] >= data_minima)
			var minimo = CALCULATE(MIN(CALENDARIO[Year_Month_Week_Fiscal]),
			            CALENDARIO[Date] <= data_massima, 
			            CALENDARIO[Date] >= data_minima)
			
			return IF(AND(SELECTEDVALUE(CALENDARIO[Year_Month_Week_Fiscal]) <= massimo, SELECTEDVALUE(CALENDARIO[Year_Month_Week_Fiscal]) >= minimo),1,0)
			```
		formatString: 0
		lineageTag: 66cdaffc-bed5-4ba0-9494-57e51e4d6073

	measure '_MeasureSelector - FreePeriod trend' = ```
			
			VAR grandezza= SELECTEDVALUE('KPI Selector'[KPI])
			var massimo = [Max date tooltip]
			var minimo = [Min date tooltip]
			
			RETURN
			    CALCULATE(
			    SWITCH(grandezza,
			        "Net Sales", [Net Sales],
			        "Traffic",[Traffic],
			        "Quantity",[Quantity],
			        "Ticket",[Ticket],
			        "Conversion Rate",[Conversion Rate],
			        "UPT",[UPT],
			        "Avg Ticket",[Avg Ticket],
			        "Average Price",[Average Price],
			        "Cross Selling", [Cross Selling], 
			        "Cross Selling RTW", [Cross Selling RTW],
			        "High Ticket #", [High Ticket Value],
			        "High Ticket Share (#)", [High Ticket Share]
			  ),
			  CALENDARIO[Date] <= massimo,
			  CALENDARIO[Date] >= minimo
			  )
			```
		lineageTag: 9a31c364-9526-4a51-9f39-f0cb0cabf2e2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

