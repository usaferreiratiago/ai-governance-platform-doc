			var settimana = CALCULATE(SELECTEDVALUE(CALENDARIO[Fiscal Week]),CALENDARIO[Date] = date_ly)
			var calcolo = CALCULATE(_measure[_CLI_MONO_VAL],
			                        --year(CALENDARIO[Date]) = anno ,
			                        (CALENDARIO[Fiscal Year]) = anno,
			                        CALENDARIO[Fiscal Week] = settimana,
			                        CALENDARIO[Date]<= date_ly
			                        )
			
			return calcolo
		displayFolder: Slide 11\Shoes Monobuyers\LY
		lineageTag: 7ff1343d-cf78-43fe-8943-d7f988178104

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SHOES MONOBUYERS Net Sales LYMTD' = ```
			
			var giorno_scelto = _measure[Selected Day]
			var anno = YEAR(giorno_scelto)-1
			var mese = MONTH(giorno_scelto)
			var giorno = DAY(giorno_scelto)
			var calcolo = CALCULATE(_measure[_CLI_MONO_VAL],  
			                        year(CALENDARIO[Date]) = anno ,
			                        month(CALENDARIO[Date]) = mese, 
			                        day(CALENDARIO[Date]) <= giorno
			                        )
			
			return calcolo
			```
		displayFolder: Slide 11\Shoes Monobuyers\LY
		lineageTag: b1a8fa51-5b61-4c64-9dd7-7f4df5d48e3b

