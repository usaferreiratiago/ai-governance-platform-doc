		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'avg cat per ticket MTD' = ```
			
			var giorno_scelto = _measure[Selected Day]
			var anno = YEAR(giorno_scelto)
			var mese = MONTH(giorno_scelto)
			var giorno = DAY(giorno_scelto)
			var calcolo = CALCULATE([Crosselling],
			                        year(CALENDARIO[Date]) = anno ,
			                        month(CALENDARIO[Date]) = mese, 
			                        day(CALENDARIO[Date]) <= giorno,
			                        OR(SCONTRINI[Ticket Type] = "SBMST", SCONTRINI[Ticket Type] = "SBVEN"), 
			                        SCONTRINI[Ticket Row Type] = "VEN"
			                        )
			
			return calcolo
			```
		formatString: 0
		displayFolder: Cross Selling
		lineageTag: 6d3f163b-eff7-42e3-9ffb-70dabe4c8b13

	measure 'avg cat per ticket YTD' = ```
			
			var giorno_scelto = _measure[Selected Day]
			var calcolo = CALCULATE( [Crosselling],
					AND( CALENDARIO[ANNO_COD] = CONVERT(YEAR(giorno_scelto),STRING),CALENDARIO[Date] <= giorno_scelto), 
					OR(SCONTRINI[Ticket Type] = "SBMST", SCONTRINI[Ticket Type] = "SBVEN"), SCONTRINI[Ticket Row Type] = "VEN")
			
			return calcolo
			```
		formatString: 0
		displayFolder: Cross Selling
		lineageTag: ef1e18a2-c56e-410a-8ffb-52f0962e571c

	measure 'avg cat per ticket Yesterday' = ```
			
			var giorno_scelto = _measure[Selected Day]
			var calcolo = CALCULATE([Crosselling], 
			        CALENDARIO[Date] = giorno_scelto,
			        OR(SCONTRINI[Ticket Type] = "SBMST", SCONTRINI[Ticket Type] = "SBVEN"), 
					SCONTRINI[Ticket Row Type] = "VEN"
			        )
			
			return calcolo
			```
		formatString: 0
		displayFolder: Cross Selling
		lineageTag: 62541dbf-1f0d-4442-8a8a-0583e45c4cce

	measure 'avg cat per ticket WTD' = ```
			
			var giorno_scelto = _measure[Selected Day]
			var anno = CALCULATE(SELECTEDVALUE(CALENDARIO[Fiscal Year]),CALENDARIO[Date] = giorno_scelto)
			var settimana = CALCULATE(SELECTEDVALUE(CALENDARIO[Fiscal Week]),CALENDARIO[Date] = giorno_scelto)
			var calcolo = CALCULATE([Crosselling], 
									--year(CALENDARIO[Date]) = anno,
			                        (CALENDARIO[Fiscal Year]) = anno,
									CALENDARIO[Fiscal Week] = settimana,
			                        CALENDARIO[Date] <= giorno_scelto,
								    OR(SCONTRINI[Ticket Type] = "SBMST", SCONTRINI[Ticket Type] = "SBVEN"), 
								    SCONTRINI[Ticket Row Type] = "VEN"
									)
			
			return calcolo
			
			```
