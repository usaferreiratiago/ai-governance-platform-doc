	measure 'Cross Selling' = ```
			
			
			var numeratore = CALCULATE(DISTINCTCOUNT(SCONTRINI[Ticket ID]),
			    SCONTRINI[N Macro Category per Ticket] > 1, 
			    OR(SCONTRINI[Ticket Type] = "SBMST", SCONTRINI[Ticket Type] = "SBVEN"), SCONTRINI[Ticket Row Type] = "VEN"
			                          )
			
			var denominatore = CALCULATE(DISTINCTCOUNT(SCONTRINI[Ticket ID]),
			                        OR(SCONTRINI[Ticket Type] = "SBMST", SCONTRINI[Ticket Type] = "SBVEN"), 
			                        SCONTRINI[Ticket Row Type] = "VEN"
			                            )
			
			var Calcolo = IF(AND(ISBLANK(numeratore),denominatore>0),0,DIVIDE(numeratore,denominatore,0))
			
			return Calcolo
			```
		formatString: 0
		displayFolder: __Test New Measures\MeasureSelector - FreePeriod\SelectedPeriod
		lineageTag: 1e9961fc-1bf3-421b-acee-51b0e30b3832

	measure 'Cross Selling RTW' = ```
			
			
			VAR numeratore = CALCULATE(
			    DISTINCTCOUNT(SCONTRINI[Ticket ID]),
			    SCONTRINI[N Category] > 1,
			    OR(SCONTRINI[Ticket Type] = "SBMST", SCONTRINI[Ticket Type] = "SBVEN"), 
			        SCONTRINI[Ticket Row Type] = "VEN"
			        )
			    
			
			VAR denominatore = CALCULATE(DISTINCTCOUNT(SCONTRINI[Ticket ID]),
			                        OR(SCONTRINI[Ticket Type] = "SBMST", SCONTRINI[Ticket Type] = "SBVEN"), 
			                        SCONTRINI[Ticket Row Type] = "VEN",
			                        SCONTRINI[Macro Category] = "RTW"
			                        )
			                        
			VAR calcolo = IF(AND(ISBLANK(numeratore),denominatore>0),0,DIVIDE(numeratore,denominatore,0))
			
			RETURN calcolo
			```
		formatString: 0
		displayFolder: __Test New Measures\MeasureSelector - FreePeriod\SelectedPeriod
		lineageTag: 0332196e-7d07-4b75-8f51-e03802028b66

	measure 'Min date tooltip' = ```
			
