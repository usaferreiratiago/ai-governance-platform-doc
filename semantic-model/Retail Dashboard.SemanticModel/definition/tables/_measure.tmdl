			        CALENDARIO[Date] = giorno_scelto,
			        OR(SCONTRINI[Ticket Type] = "SBMST", SCONTRINI[Ticket Type] = "SBVEN"), 
					SCONTRINI[Ticket Row Type] = "VEN"
			        )
			        
			return calcolo
