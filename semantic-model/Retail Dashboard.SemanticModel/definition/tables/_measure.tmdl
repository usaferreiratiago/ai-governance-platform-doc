	measure '_Titolo Drill Through - liv 2' = ```
			
			/*Var res = IF(ISFILTERED(NEGOZI[Store Description]), MAX(NEGOZI[Store Description])&" ", 
			             IF(ISFILTERED(NAZIONI[Country Description]), MAX(NAZIONI[Country Description])&" ",
			             IF(ISFILTERED(AREA_MANAGER[Area Manager Description]), MAX(AREA_MANAGER[Area Manager Description])&" ",
			              IF(ISFILTERED(GERARCHIA_AREA[Area Description]), MAX(GERARCHIA_AREA[Area Description])&" ","")
			             ) ) )
			
			*/
			Var res = IF(DISTINCTCOUNT(NEGOZI[Store Description]) =1 , MAX(NEGOZI[Store Description])&" ", 
			             IF(DISTINCTCOUNT(NAZIONI[Country Description]) = 1, MAX(NAZIONI[Country Description])&" ",
			             IF(DISTINCTCOUNT(AREA_MANAGER[Area Manager Description]) = 1 , MAX(AREA_MANAGER[Area Manager Description])&" ",
			              IF(DISTINCTCOUNT(GERARCHIA_AREA[Area Description]) < 7, CONCATENATEX(GERARCHIA_AREA, [Area Description], "-")&" ","Worldwide")
			             ) ) )
			VAR grandezza= SELECTEDVALUE('KPI Selector'[KPI])
			var _sommaperiod = [_TY Retail Equation]
			var _sommafree = [_MeasureSelector - FreePeriod]
			var _somma = IF(
			                HASONEFILTER('Period Selector'[Period]),
			                _sommaperiod,
			                _sommafree
			)
			var _format = 
			if( grandezza="Net Sales",
			coalesce(
			    if(ABS(_somma)<=10^3,format(_somma,"#,##0.0"),
			    if(ABS(_somma)<=10^6,format(_somma,"#,##0,.0K"), 
			    if(ABS(_somma)<=10^9,format(_somma,"#,##0,,.0Mln"),
			    format(_somma,"#,##0,,,.0Bn")))),"-"),
			format(_somma, "#,0")
			)
			Return IF(AND([Check Currency Consistency V2]=1, [Filter Drill lev 2 v2]=1), res & "(Total This Year: " & _format & ")", res)
			
			
			```
		lineageTag: 5b6afb63-71f2-430a-8334-d207bb305f2a

