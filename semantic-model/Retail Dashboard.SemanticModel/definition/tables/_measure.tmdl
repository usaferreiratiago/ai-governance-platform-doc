	measure '_TY Retail Equation' = ```
			
			VAR grandezza= SELECTEDVALUE('KPI Selector'[KPI])
			VAR periodo = SELECTEDVALUE('Period Selector'[Period])
			RETURN
			SWITCH(periodo,
			"YTD",
			    SWITCH(grandezza,
			        "Net Sales", [Net Sales YTD],
			        "Traffic",[Traffic YTD],
			        "Quantity",[Unit YTD],
			        "Ticket",[Ticket Number YTD],
			        "Conversion Rate", [Conversion Rate YTD],
			        "UPT",[UPT YTD],
			        "Avg Ticket",[Avg Ticket YTD],
			        "Average Price",[Avg Price YTD],
			        "Cross Selling", [Cross selling YTD], 
			        "Cross Selling RTW", [Cross selling RTW YTD],
			        "High Ticket #", [High Ticket Value YTD],
			        "High Ticket Share (#)", [High Ticket Share YTD]
			    ),
			"MTD",
			    SWITCH(grandezza,
			        "Net Sales", [Net Sales MTD],
			        "Traffic",[Traffic MTD],
			        "Quantity",[Unit MTD],
			        "Ticket",[Ticket Number MTD],
			        "Conversion Rate",[Conversion Rate MTD],
			        "UPT",[UPT MTD],
			        "Avg Ticket",[Avg Ticket MTD],
			        "Average Price",[Avg Price MTD],
			        "Cross Selling", [Cross selling MTD], 
			        "Cross Selling RTW", [Cross selling RTW MTD],
			        "High Ticket #", [High Ticket Value MTD],
			        "High Ticket Share (#)", [High Ticket Share MTD]
			    ),
			"WTD",
			    SWITCH(grandezza,
			        "Net Sales", [Net Sales WTD],
			        "Traffic",[Traffic WTD],
			        "Quantity",[Unit WTD],
			        "Ticket",[Ticket Number WTD],
			        "Conversion Rate",[Conversion Rate WTD],
			        "UPT",[UPT WTD],
			        "Avg Ticket",[Avg Ticket WTD],
			        "Average Price",[Avg Price WTD],
			        "Cross Selling", [Cross selling WTD], 
			        "Cross Selling RTW" ,[Cross selling RTW WTD],
			        "High Ticket #", [High Ticket Value WTD],
			        "High Ticket Share (#)", [High Ticket Share WTD]
			    )
			)
			```
