			VAR NetSalesFormat = [Net Sales Format]
			RETURN
			SWITCH(periodo,
			"YTD",
			    SWITCH(grandezza,
			        "Net Sales", DIVIDE([Net Sales YTD], NetSalesFormat),
			        "Traffic",[Traffic YTD],
			        "Quantity",[Unit YTD],
			        "Ticket",[Ticket Number YTD],
			        "Conversion Rate", [Conversion Rate YTD],
