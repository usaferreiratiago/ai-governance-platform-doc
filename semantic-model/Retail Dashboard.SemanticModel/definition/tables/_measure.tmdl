	measure 'Net Sales YTD for delta' =
			
			
			var giorno_scelto = _measure[Selected Day]
			var anno = YEAR(giorno_scelto)
			var mese = MONTH(giorno_scelto)
			var giorno = DAY(giorno_scelto)
			var calcolo = CALCULATE([Net Sales Euro Constant Exchange],  year(CALENDARIO[Date]) = anno , CALENDARIO[Date] <= giorno_scelto)
			
