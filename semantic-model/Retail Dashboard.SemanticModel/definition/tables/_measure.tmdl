				        "Traffic","+0.0%;-0.0%",
				        "Quantity","+0.0%;-0.0%",
				        "Ticket","+0.0%;-0.00%",
				        "Conversion Rate","+0.0pp;-0.0pp",
				        "UPT","+0.0%;-0.0%",
				        "Avg Ticket","+0.0%;-0.0%",
				        "Average Price","+0.0%;-0.0%",
				        "Cross Selling", "+0.0pp;-0.0pp", 
				        "Cross Selling RTW", "+0.0pp;-0.0pp",
				        "High Ticket #", "+0.0%;-0.0%",
