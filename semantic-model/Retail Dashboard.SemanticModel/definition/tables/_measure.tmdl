			var anno = CALCULATE(SELECTEDVALUE(CALENDARIO[Fiscal Year]),CALENDARIO[Date] = date_ly)
			var settimana = CALCULATE(SELECTEDVALUE(CALENDARIO[Fiscal Week]),CALENDARIO[Date] = date_ly)
			var calcolo = CALCULATE([Crosselling RTW], 
