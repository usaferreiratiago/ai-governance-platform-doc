	measure 'Traffic MTD slide 6' = ```
			
			 var MTD_cy = [Traffic MTD]
			 var variazione = [Traffic MTD vs LY %]
			
			 return
			coalesce(
			    if(ABS(MTD_cy)<=10^3,format(MTD_cy,"#,##0.00"),
			    if(ABS(MTD_cy)<=10^6,format(MTD_cy,"#,##0,.00K"), 
			    if(ABS(MTD_cy)<=10^9,format(MTD_cy,"#,##0,,.00Mln"),
			    format(MTD_cy,"#,##0,,,.00Bn")))),"-")  
			&UNICHAR(10) &
