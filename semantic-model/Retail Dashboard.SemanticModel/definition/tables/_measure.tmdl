	measure 'Cross Selling LY' = ```
			
			var end_date = [EndDate]
			var start_date = [StartDate]
			
			var minimo = CALCULATE(MIN(CALENDARIO[COD_AGO_DTA]), CALENDARIO[Date]=start_date) //[Min date tooltip]-367
			var massimo = CALCULATE(MAX(CALENDARIO[COD_AGO_DTA]), CALENDARIO[Date]=end_date) //TODAY()-364
			
			var numeratore = CALCULATE(DISTINCTCOUNT(SCONTRINI[Ticket ID]),
			    CALENDARIO[Date]>=minimo, CALENDARIO[Date]<=massimo,
			    SAMEPERIODLASTYEAR(CALENDARIO[Date]),
			    SCONTRINI[N Macro Category per Ticket] > 1, 
			    OR(SCONTRINI[Ticket Type] = "SBMST", SCONTRINI[Ticket Type] = "SBVEN"), SCONTRINI[Ticket Row Type] = "VEN"
			 )
			
			var denominatore = CALCULATE(DISTINCTCOUNT(SCONTRINI[Ticket ID]),
			                    CALENDARIO[Date]>=minimo, CALENDARIO[Date]<=massimo,
			                       SAMEPERIODLASTYEAR(CALENDARIO[Date]),
			                        OR(SCONTRINI[Ticket Type] = "SBMST", SCONTRINI[Ticket Type] = "SBVEN"), 
			                        SCONTRINI[Ticket Row Type] = "VEN"
			                        )
			
			var Calcolo = IF(AND(ISBLANK(numeratore),denominatore>0),0,DIVIDE(numeratore,denominatore,0))
			
			return Calcolo
			```
		displayFolder: __Test New Measures\MeasureSelector - FreePeriod\Year-1 SelectedPeriod
		lineageTag: ba935402-86be-4280-8acc-f1395d187f7c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cross Selling RTW LY' = ```
			
			var end_date = [EndDate]
			var start_date = [StartDate]
			
			var minimo = CALCULATE(MIN(CALENDARIO[COD_AGO_DTA]), CALENDARIO[Date]=start_date) //[Min date tooltip]-367
			var massimo = CALCULATE(MAX(CALENDARIO[COD_AGO_DTA]), CALENDARIO[Date]=end_date) //TODAY()-364
			
			VAR numeratore = CALCULATE(
			    DISTINCTCOUNT(SCONTRINI[Ticket ID]),
			    SCONTRINI[N Category] > 1,
			    CALENDARIO[Date]>=minimo, CALENDARIO[Date]<=massimo,
			    SAMEPERIODLASTYEAR(CALENDARIO[Date]),
			    OR(SCONTRINI[Ticket Type] = "SBMST", SCONTRINI[Ticket Type] = "SBVEN"), 
			        SCONTRINI[Ticket Row Type] = "VEN"
			        )
			    
			
			VAR denominatore = CALCULATE(DISTINCTCOUNT(SCONTRINI[Ticket ID]),
			                        CALENDARIO[Date]>=minimo, CALENDARIO[Date]<=massimo,
			                        SAMEPERIODLASTYEAR(CALENDARIO[Date]),
			                        OR(SCONTRINI[Ticket Type] = "SBMST", SCONTRINI[Ticket Type] = "SBVEN"), 
			                        SCONTRINI[Ticket Row Type] = "VEN",
			                        SCONTRINI[Macro Category] = "RTW"
			                        )
			                        
			VAR calcolo = IF(AND(ISBLANK(numeratore),denominatore>0),0,DIVIDE(numeratore,denominatore,0))
			
			RETURN calcolo
			```
		formatString: 0
		displayFolder: __Test New Measures\MeasureSelector - FreePeriod\Year-1 SelectedPeriod
		lineageTag: a6c43d4d-9927-43a7-b1b0-501c68a3c949

