	measure '_MeasureSelector - FreePeriod LY' = ```
			VAR grandezza= SELECTEDVALUE('KPI Selector'[KPI])
			
			RETURN
			    SWITCH(grandezza,
			        "Net Sales", [Net Sales LY],
			        "Traffic",[Traffic LY],
			        "Quantity",[Quantity LY],
			        "Ticket",[Ticket LY],
			        "Conversion Rate",[Conversion Rate LY],
			        "UPT",[UPT LY],
			        "Avg Ticket",[Avg Ticket LY],
			        "Average Price",[Avg Price LY],
			        "Cross Selling", [Cross Selling LY], 
			        "Cross Selling RTW", [Cross Selling RTW LY],
			        "High Ticket #", [High Ticket Value LY],
			        "High Ticket Share (#)", [High Ticket Share LY]
			  )
			```
		displayFolder: __Test New Measures\MeasureSelector - FreePeriod\Year-1 SelectedPeriod
		lineageTag: fedabac4-f3cf-43ce-81f9-eb7082badba4

		formatStringDefinition = ```
				VAR _kpi = SELECTEDVALUE('KPI Selector'[KPI])
