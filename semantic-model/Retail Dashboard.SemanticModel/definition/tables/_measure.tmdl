	measure 'Avg Ticket' =
			
			/*
			var net_sales_ytd = CALCULATE([Net Sales],OR(SCONTRINI[Ticket Row Type] = "VEN",
			                                             SCONTRINI[Ticket Row Type] = "RES"))
			*/
			
			var calcolo = DIVIDE([Net Sales], [Ticket])
			
