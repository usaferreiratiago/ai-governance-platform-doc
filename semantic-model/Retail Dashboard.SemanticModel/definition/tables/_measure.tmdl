	measure StartDate =
			
			
			var giorno_scelto = [Selected Day]
			var settimana = CALCULATE(SELECTEDVALUE(CALENDARIO[Fiscal Week]),CALENDARIO[Date] = giorno_scelto)
			var anno = CALCULATE(SELECTEDVALUE(CALENDARIO[Fiscal Year]),CALENDARIO[Date] = giorno_scelto)
			
			var result = SWITCH(SELECTEDVALUE('Period Selector'[Period]),
			    "YTD",DATE(YEAR(giorno_scelto),1,1),
			    "MTD",DATE(YEAR(giorno_scelto),MONTH(giorno_scelto),1),
			    "WTD",CALCULATE(MIN(CALENDARIO[Date]),FILTER(CALENDARIO, AND(CALENDARIO[Fiscal Week] = settimana, CALENDARIO[Fiscal Year] = anno))),
			    MIN(CALENDARIO[Date])
			    )
			return result
		formatString: General Date
		lineageTag: 6176a0f2-555a-4e52-82f2-2eac5bd28c39

	measure '% Mix Country/Store' = ```
			
			var calcolo = DIVIDE([_TY Retail Equation], 
			                                    CALCULATE([_TY Retail Equation],
			                                    ALLSELECTED(AREA_MANAGER),
			                                    ALLSELECTED(NAZIONI),
			                                    ALLSELECTED(NEGOZI)
			                                    )
			)
			Return IF(
			    SELECTEDVALUE('KPI Selector'[KPI]) = "Net Sales"
			    ||
			    SELECTEDVALUE('KPI Selector'[KPI]) = "Quantity",
			    calcolo,
			    BLANK()
			)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 57743375-37e1-460f-9f10-0e8a2dd7f7a3

