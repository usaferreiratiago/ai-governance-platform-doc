	measure 'Delta % - Selector - FreePeriod' = ```
			
			
			VAR grandezza= SELECTEDVALUE('KPI Selector'[KPI])
			
			RETURN
			    SWITCH(grandezza,
			        "Net Sales", IF([Check Currency Consistency V2] =1,[Net Sales % - FreePeriod],BLANK()),
			        "Traffic",[Traffic % - FreePeriod],
			        "Quantity",[Quantity % - FreePeriod],
			        "Ticket",[Ticket % - FreePeriod],
			        "Conversion Rate",[Conversion Rate pp - FreePeriod],
			        "UPT",[UPT % - FreePeriod],
			        "Avg Ticket",IF([Check Currency Consistency V2] =1,[Avg Ticket % - FreePeriod],BLANK()),
			        "Average Price",IF([Check Currency Consistency V2] =1,[Average Price % - FreePeriod],BLANK()),
			        "Cross Selling", [Cross Selling pp - FreePeriod], 
			        "Cross Selling RTW", [Cross Selling RTW pp - FreePeriod],
			        "High Ticket #", [High Ticket Value % - FreePeriod],
			        "High Ticket Share (#)", [High Ticket Share pp - FreePeriod]
			  )
			```
		displayFolder: __Delta % - FreePeriod
		lineageTag: deb8ba48-a101-4b1d-aac6-57117eac2fd5

		formatStringDefinition = ```
				VAR _kpi = SELECTEDVALUE('KPI Selector'[KPI])
				RETURN
