	measure 'Unit MTD slide 7' = ```
			
			 var MTD_cy = [Unit MTD]
			 var variazione = [Unit MTD vs LY %]
			
			 return
			coalesce(
			    if(ABS(MTD_cy)<=10^3,format(MTD_cy,"#,##0"),
			    if(ABS(MTD_cy)<=10^6,format(MTD_cy,"#,##0,.00K"), 
			    if(ABS(MTD_cy)<=10^9,format(MTD_cy,"#,##0,,.00Mln"),
			    format(MTD_cy,"#,##0,,,.00Bn")))),"-")  
			&UNICHAR(10) &
			if(isblank(variazione),blank(),format(variazione,"+0.00%;-0.00%") )
			```
		displayFolder: Unit\Slide 7
		lineageTag: 16ba5270-aa43-4a3b-8f87-52339a5ac174

