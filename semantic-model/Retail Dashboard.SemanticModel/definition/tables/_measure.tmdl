	measure 'Net Sales Markdown YTD' =
			var giorno_scelto = _measure[Selected Day]
			var anno = YEAR(giorno_scelto)
			var mese = MONTH(giorno_scelto)
			var giorno = DAY(giorno_scelto)
			var calcolo = CALCULATE([Net Sales Euro Current Exchange],  year(CALENDARIO[Date]) = anno , CALENDARIO[Date] <= giorno_scelto, SCONTRINI[Flag Sale] = "1")
			
			return calcolo
		displayFolder: __Test New Measures\Net Sales period\Net Sales Markdown
