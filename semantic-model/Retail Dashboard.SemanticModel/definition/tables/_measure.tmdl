	measure 'Average Price for delta' =
			
			VAR numeratore = [Net Sales Euro Constant Exchange] /*calculate([Net Sales Euro Constant Exchange],
			                                        OR( SCONTRINI[Ticket Row Type] = "VEN",SCONTRINI[Ticket Row Type] = "RES"))*/
			VAR denominatore = [Quantity] /*calculate([Quantity],
			                                        OR( SCONTRINI[Ticket Row Type] = "VEN", SCONTRINI[Ticket Row Type] = "RES"))*/
			
			VAR calcolo =  IF(AND(ISBLANK(numeratore),denominatore>0),0,DIVIDE(numeratore,denominatore,0))
			RETURN calcolo
