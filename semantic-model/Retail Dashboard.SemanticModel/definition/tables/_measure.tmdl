			var anno = YEAR(giorno_scelto)-1
			var mese = MONTH(giorno_scelto)
			var giorno = DAY(giorno_scelto)
			var calcolo = CALCULATE([Crosselling], 
			                        year(CALENDARIO[Date]) = anno ,
			                        month(CALENDARIO[Date]) = mese, 
			                        day(CALENDARIO[Date]) <= giorno,
			                        OR(SCONTRINI[Ticket Type] = "SBMST", SCONTRINI[Ticket Type] = "SBVEN"), 
			                        SCONTRINI[Ticket Row Type] = "VEN"
			                        )
			
			return calcolo
			```
		formatString: 0
		displayFolder: Cross Selling
		lineageTag: 7ee074fa-1d22-4c0f-9176-ad275cc3c348

	measure 'avg cat per ticket LYTD' = ```
			
			var giorno_scelto = _measure[Selected Day]
			var date_ly = CALCULATE(SELECTEDVALUE(CALENDARIO[Date LY]),CALENDARIO[Date] = giorno_scelto)
			
			var calcolo = CALCULATE([Crosselling], 
			                        CALENDARIO[ANNO_COD] =  CONVERT(YEAR(date_ly),STRING),
			                        CALENDARIO[Date]<= date_ly, 
			                        OR(SCONTRINI[Ticket Type] = "SBMST", SCONTRINI[Ticket Type] = "SBVEN"),
			                        SCONTRINI[Ticket Row Type] = "VEN"
			                        )
			return
			calcolo
			```
		formatString: 0
		displayFolder: Cross Selling
		lineageTag: 3c860d3b-fce6-41e1-88de-e6e202fe15dd

	measure 'Cross selling LYMTD' = ```
			
			VAR numeratore = _measure[avg cat per ticket LYMTD]
			VAR denominatore = [Ticket Number LYMTD]                       
			
			VAR calcolo =  IF(AND(ISBLANK(numeratore),denominatore>0),0,DIVIDE(numeratore,denominatore,0))
			RETURN calcolo
			```
