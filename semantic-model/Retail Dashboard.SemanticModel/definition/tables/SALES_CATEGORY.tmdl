table SALES_CATEGORY
	lineageTag: 28e962e8-40d5-4cba-9361-3ee0b4651d05

	column SalesCategoryCode
		dataType: string
		lineageTag: 6de6cc02-7d06-45d5-a127-c252657a937f
		summarizeBy: none
		sourceColumn: Sales Category Code

		annotation SummarizationSetBy = Automatic

		annotation Description = "Unique code identifying a sales category (e.g., 'SC01', 'SC02'). Used to link products to their sales category for revenue analysis. Proposed – pending Loro Piana validation."

		annotation Synonyms = "Sales Category Code, Revenue Category ID, Category Code"

		annotation DisplayFolder = "Sales Category Details"

		annotation 'Example Values' = "SC01, SC02, SC03, SC04, SC05"

		annotation 'Common Questions' = "What is the sales category code for Bags? How many products are in each sales category? Which sales category has the highest revenue?"

		annotation 'Related Objects' = "ARTICOLI, SCONTRINI"

	column SalesCategoryDescriptionITA
		dataType: string
