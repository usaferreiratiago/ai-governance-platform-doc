	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

	annotation Description = "Sales category dimension for the luxury retail assortment. Defines product categorization used for sales reporting and revenue analysis. Provides bilingual labels (Italian and English) for international reporting. Links to products and sales transactions for category-level performance analysis. Grain: one row per sales category code. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Sales Category, Revenue Category, Sales Classification, Product Category"

	annotation DisplayFolder = "Product Master"

	annotation RefreshPolicy = "Weekly on Sundays at 00:00 UTC; data latency ≤ 48 hours. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana Commercial Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "SC01: Bags / Borse, SC02: Shoes / Scarpe, SC03: Ready-to-Wear / Abbigliamento, SC04: Accessories / Accessori"

	annotation 'Common Questions' = "What are the sales categories? How do sales categories differ from product categories? What is the revenue mix by sales category? Which sales category has the highest sales?"

	annotation 'Related Objects' = "ARTICOLI, CLASSE_PRODOTTO, SCONTRINI, TARGET"
