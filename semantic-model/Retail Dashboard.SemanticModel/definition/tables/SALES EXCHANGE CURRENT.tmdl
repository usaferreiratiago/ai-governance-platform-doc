		sourceColumn: Currency Sales

		annotation SummarizationSetBy = Automatic

		annotation Description = "ISO currency code for the current exchange rate (e.g., 'EUR', 'USD', 'GBP'). The base currency for the exchange rate. Proposed – pending Loro Piana validation."

		annotation Synonyms = "Currency, ISO Code, Currency Code, FX Currency"

		annotation DisplayFolder = "Currency Details"

		annotation 'Example Values' = "EUR, USD, GBP, CHF, JPY"

		annotation 'Common Questions' = "What currencies have current exchange rates? What is the current exchange rate for USD?"

		annotation 'Related Objects' = "'Currency Selection'.[CurrencyCode]"

