	column SubCategoryCode
		dataType: string
		lineageTag: d339f4a2-22fb-4d0e-afec-2aeb677f924c
		summarizeBy: none
		sourceColumn: Sub Category Code

		annotation SummarizationSetBy = Automatic

		annotation Description = "Unique code identifying a product sub-category (e.g., 'DRS' for Dresses, 'SHP' for Shoes). Used to link products to their sub-category classification and for detailed assortment analysis. Proposed – pending Loro Piana validation."

		annotation Synonyms = "Sub-Category Code, Sub-Category ID, Detailed Category Code, Merchandise Sub-Category Code"

		annotation DisplayFolder = "Sub-Category Details"

		annotation 'Example Values' = "DRS, SHP, BAG, KNT, WOV, ACC, JWL, SLG"

		annotation 'Common Questions' = "What is the sub-category code for Dresses? How many products are in each sub-category? Which sub-category has the highest sales?"

		annotation 'Related Objects' = "ARTICOLI.'Sub Category Code', SOTTO_CLASSE_PRODOTTO"

