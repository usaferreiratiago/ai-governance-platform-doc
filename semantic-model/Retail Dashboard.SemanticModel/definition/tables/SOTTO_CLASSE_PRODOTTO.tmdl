	annotation Description = "Sub-category dimension for the luxury retail assortment. Defines detailed product sub-category classifications within the main product category hierarchy. Includes bilingual descriptions (Italian and English) for international reporting. Links to products and parent categories for granular assortment analysis. Grain: one row per sub-category code. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Sub-Category, Product Sub-Category, Sub-Category Dimension, Detailed Category, Merchandise Sub-Category"

	annotation DisplayFolder = "Product Master"

	annotation RefreshPolicy = "Weekly on Sundays at 00:00 UTC; data latency ≤ 48 hours. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana Product Management Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "DRS: Dresses / Abiti, SHP: Shoes / Scarpe, BAG: Bags / Borse, KNT: Knitwear / Maglieria"

	annotation 'Common Questions' = "What are the sub-categories within Ready-to-Wear? How do sub-categories perform by sales? Which sub-category has the highest growth? How do Italian and English sub-category names compare?"

	annotation 'Related Objects' = "ARTICOLI, CLASSE_PRODOTTO, SOTTO_CLASSE_PRODOTTO, SCONTRINI, TARGET"
