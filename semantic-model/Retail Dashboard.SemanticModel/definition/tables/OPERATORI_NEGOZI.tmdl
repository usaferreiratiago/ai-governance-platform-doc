table OPERATORI_NEGOZI
	lineageTag: dafb2b75-9e56-44b5-a33c-ef2c1ae1f003

	column StoreCode
		dataType: string
		lineageTag: c6837d04-4895-4d6b-aecf-1792ff203d38
		summarizeBy: none
		sourceColumn: Store Code

		annotation SummarizationSetBy = Automatic

		annotation Description = "Store code where the sales associate is assigned (e.g., 'LP001', 'LP002'). Links to the Stores dimension for store-level analysis. Proposed – pending Loro Piana validation."

		annotation Synonyms = "Store ID, Store Code, Location Code, Assigned Store"

		annotation DisplayFolder = "Associate Details"

		annotation 'Example Values' = "LP001, LP002, LP003, LP004"

		annotation 'Common Questions' = "Which store does the associate work at? How many associates are in each store?"

		annotation 'Related Objects' = "STORES.'Store Code'"

