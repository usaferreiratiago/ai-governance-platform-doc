		annotation Description = "Import partition for sales associate master data. Loads all associate records without date filtering."

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

	annotation Description = "Sales associate dimension for the luxury retail model. Contains store sales associate (SA) information including codes, names, and store assignments. Enables sales performance analysis at the individual associate level, tracking productivity, conversion rates, and client engagement. Links to stores for location-based analysis. Grain: one row per sales associate. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Sales Associates, Store Operators, Sales Staff, Store Employees, Associates"

	annotation DisplayFolder = "Store Master"

	annotation RefreshPolicy = "Weekly on Sundays at 00:00 UTC; data latency ≤ 48 hours. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana Retail Operations Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "Store: LP001, Associate: 12345, Name: Maria Bianchi"

	annotation 'Common Questions' = "Who are the sales associates at each store? What is the performance of each associate? Which store has the most associates? Who is the top-performing sales associate?"

	annotation 'Related Objects' = "STORES, SCONTRINI, TARGET"
