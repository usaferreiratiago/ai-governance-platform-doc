table 'Currency Selector'
	lineageTag: a434b5b8-7659-4f4a-8f05-00c1e11680d6

	column CurrencyCode
		dataType: string
		lineageTag: 67c61f5d-fff8-43d8-9c88-7d31243927bd
		summarizeBy: none
		sourceColumn: Currency

		annotation SummarizationSetBy = Automatic

		annotation Description = "ISO currency code (e.g., EUR, USD, GBP). Used as the selection value for currency conversion and multi-currency reporting. Proposed – pending Loro Piana validation."

		annotation Synonyms = "Currency, Currency Code, ISO Code, FX Code, Reporting Currency"

		annotation DisplayFolder = "Currency Selection"

		annotation 'Example Values' = "EUR, USD, GBP, CHF, JPY, CNY"

		annotation 'Common Questions' = "What is the currency code for Euro? How do I select a different reporting currency? Which currencies are supported in the model?"

