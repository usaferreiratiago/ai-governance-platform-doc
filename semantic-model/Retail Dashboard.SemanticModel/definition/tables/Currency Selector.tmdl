	partition 'Currency Selector' = m
		mode: import
		source =
				let
				        Origine = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Currency = _t]),
				        #"Changed Type" = Table.TransformColumnTypes(Origine,{{"Currency", type text}})
				in
				        #"Changed Type"

		annotation Description = "Static import partition containing a hardcoded list of supported currencies. The current list includes: EUR, USD, GBP, CHF, JPY, CNY. This is a static selection table used for currency conversion reports. Proposed – pending Loro Piana validation on currency list completeness."

	annotation PBI_ResultType = Table

	annotation Description = "Currency selection dimension for dynamic currency conversion in reports. Provides a list of available currencies for user selection, enabling multi-currency reporting and comparative analysis across different currency denominations. Grain: one row per currency code. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Currency, Currency Picker, Currency Selection, FX Currency, Reporting Currency"

	annotation DisplayFolder = "Parameters"

	annotation RefreshPolicy = "Static hardcoded currency list. No refresh required. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana Finance Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "EUR, USD, GBP, CHF, JPY, CNY"

	annotation 'Common Questions' = "Which currencies are available for reporting? How do I change the reporting currency? What is the base currency for the model? How do I compare sales in EUR vs USD?"

	annotation 'Related Objects' = "FACT_SALES, EXCHANGE_RATES, SCONTRINI, TARGET"
