	partition 'Delivery Date Table' = calculated
		mode: import
		source = Calendar(Date(Year(MIN('ARTICOLI_COLORE'[Delivery Date From])), 1, 1), Date(Year(MAX('ARTICOLI_COLORE'[Delivery Date From])), 12, 31))

		annotation Description = "Auto-generated local date table partition. Date range is dynamically calculated from the ARTICOLI_COLORE table's Delivery Date From column, spanning full years from the minimum to maximum delivery year. This ensures the date table covers all delivery dates referenced in the model. Proposed – pending Loro Piana validation on data source and date range logic."

	annotation __PBI_LocalDateTable = true

	annotation Description = "Power BI auto-generated local date table providing a continuous date range for delivery date-based time intelligence calculations. This hidden table serves as the foundation for date-based relationships and time intelligence functions specifically for delivery dates (e.g., ARTICOLI_COLORE[Delivery Date From]). Contains standard date attributes including Year, Quarter, Month, and Day, with a default 'Date Hierarchy' for drill-down analysis. Date range is dynamically derived from the 'ARTICOLI_COLORE' table's Delivery Date From column (full years only). Proposed – pending Loro Piana validation."

	annotation Synonyms = "Delivery Date Table, Date Dimension, Time Dimension, Calendar Table, Date Hierarchy"

	annotation DisplayFolder = "System Tables"

	annotation RefreshPolicy = "Dynamically generated based on ARTICOLI_COLORE table data range. No manual refresh required. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana BI Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "Date: 2024-01-01, Year: 2024, Quarter: Qtr 1, Month: January, Day: 1"

	annotation 'Common Questions' = "What is the delivery date range of the model? How do I use the date hierarchy for delivery dates? How do I filter by delivery year, quarter, or month? What is the delivery date table used for?"

