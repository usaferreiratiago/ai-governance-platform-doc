	partition 'Currency Exchange Rates' = m
		mode: import
		source =
				let
				        Source = PowerPlatform.Dataflows(null),
				        Workspaces = Source{[Id="Workspaces"]}[Data],
				        WS = Workspaces{[workspaceId="63075e43-ec19-4090-b204-854337b4b0d5"]}[Data],
				        DF = WS{[dataflowId="6804c67d-0461-48e3-ab6d-b7fbc7a14fc5"]}[Data],
				        CAMBI_MENSILI_CURR_SAME_DATE_ = DF{[entity="CAMBI_MENSILI_CURR_SAME_DATE",version=""]}[Data]
				in
				        CAMBI_MENSILI_CURR_SAME_DATE_

		annotation Description = "Import partition for monthly currency exchange rates. Loads all exchange rate records without date filtering."

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

	annotation Description = "Currency exchange rate dimension for the luxury retail model. Contains monthly exchange rates for different currencies used in sales reporting. Includes both average and closing exchange rates for currency conversion and financial reporting. Links to time dimensions (Year, Month, YearMonth) for period-based analysis. Grain: one row per currency per year-month combination. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Exchange Rates, Currency Rates, FX Rates, Currency Conversion, Forex Rates"

	annotation DisplayFolder = "Financial"

	annotation RefreshPolicy = "Weekly on Sundays at 00:00 UTC; data latency ≤ 48 hours. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana Finance Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "Currency: EUR, Year: 2024, Month: 01, Exchange: 1.0000, Closing: 1.0012; Currency: USD, Year: 2024, Month: 01, Exchange: 0.9200, Closing: 0.9215"

	annotation 'Common Questions' = "What exchange rates are available? How do I convert sales to local currency? What is the exchange rate for USD in January 2024? What is the closing rate vs average rate?"

	annotation 'Related Objects' = "SCONTRINI, TARGET, BUDGET, 'Currency Selection'"
