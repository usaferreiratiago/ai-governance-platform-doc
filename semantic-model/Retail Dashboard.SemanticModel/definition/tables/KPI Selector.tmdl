		lineageTag: 0be0f77f-3798-4ea6-bb76-8214cfa028fe
		summarizeBy: sum
		sourceColumn: order

		annotation SummarizationSetBy = Automatic

		annotation Description = "Numeric sort order for KPI display in selection controls. Lower numbers appear first. Proposed – pending Loro Piana validation."

