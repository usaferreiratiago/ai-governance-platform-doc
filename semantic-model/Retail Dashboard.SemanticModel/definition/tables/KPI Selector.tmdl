	annotation PBI_ResultType = Table

	annotation Description = "KPI selection dimension for dynamic metric switching in reports. Provides a user-selectable list of Key Performance Indicators (KPIs) with display labels and sorting. Enables users to switch between different metrics (e.g., Revenue, Units, Average Price) in visuals without rebuilding reports. Grain: one row per KPI. Proposed – pending Loro Piana validation."

	annotation Synonyms = "KPI Selector, Metric Selector, KPI Picker, Dynamic Metrics, Performance Indicators"

	annotation DisplayFolder = "Parameters"

	annotation RefreshPolicy = "Static hardcoded list. No refresh required. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana BI Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "Revenue, Units Sold, Average Price, Gross Margin, Sell-Through Rate, Conversion Rate"

	annotation 'Common Questions' = "How do I switch KPIs in a report? What KPIs are available for selection? How do I change the displayed metric? Which KPI shows revenue vs units?"

	annotation 'Related Objects' = "SCONTRINI, TARGET, BUDGET, _measure"
