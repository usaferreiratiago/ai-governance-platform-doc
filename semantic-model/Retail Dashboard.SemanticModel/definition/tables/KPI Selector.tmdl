		annotation SummarizationSetBy = Automatic

		annotation Description = "Business-friendly name of the Key Performance Indicator (e.g., 'Revenue', 'Units Sold'). Use this field for selection controls and visual labels. Proposed – pending Loro Piana validation."

		annotation Synonyms = "KPI Name, Metric Name, Performance Indicator, KPI Label"

		annotation DisplayFolder = "KPI Selection"

		annotation 'Example Values' = "Revenue, Units Sold, Average Price, Gross Margin, Sell-Through Rate"

		annotation 'Common Questions' = "What are the available KPIs? How do I select Revenue? What KPIs can I display?"

		annotation 'Related Objects' = "_measure"

	column KPISortOrder
