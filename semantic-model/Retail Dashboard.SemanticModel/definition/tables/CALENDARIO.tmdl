		annotation Synonyms = "Fiscal Week Code, YW Code"

		annotation DisplayFolder = "Fiscal Calendar"

	column DateLastYear = IF(CALENDARIO[COD_AGO_DTA]=BLANK(), DATE(YEAR(CALENDARIO[Date])-1, MONTH(CALENDARIO[Date]),DAY(CALENDARIO[Date])-1), CALENDARIO[COD_AGO_DTA])
		dataType: dateTime
		formatString: General Date
		lineageTag: 77c70028-f496-4d18-85dd-52b6bd0d4fff
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation Description = "Date shifted by one year (same calendar day, month). Uses COD_AGO_DTA if available, otherwise calculates by subtracting one year. Proposed – pending Loro Piana validation."

		annotation Synonyms = "LY Date, Same Day Last Year"

		annotation DisplayFolder = "Date Shifts"

	partition CALENDARIO = m
		mode: import
		source =
				let
				        Origine = PowerPlatform.Dataflows(null),
				        Workspaces = Origine{[Id="Workspaces"]}[Data],
				        WS = Workspaces{[workspaceId="63075e43-ec19-4090-b204-854337b4b0d5"]}[Data],
				        DF = WS{[dataflowId="e0866c2a-0125-4d05-9009-d7f935901d88"]}[Data],
				        DIM_TIME_ANG1 = DF{[entity="DIM_TIME_ANG"]}[Data],
				        #"Removed Other Columns" = Table.SelectColumns(DIM_TIME_ANG1,{"Date", "ANNO_MESE_COD", "WEEK_COD", "MESE_DES", "ANNO_COD", "END_MONTH_DTA", "DAY_OF_WEEK_COD", "COD_AGO_DTA", "ANNO_AGO_COD", "ANNO_MESE_AGO_COD", "DATA_2AGO_DTA", "ANNO_2AGO_COD", "ANNO_MESE_2AGO_COD", "COD_3AGO_DTA", "ANNO_3AGO_COD", "ANNO_MESE_3AGO_COD", "DATA_WAGO_DTA", "DATA_2WAGO_DTA", "DAAT_3WAGO_DTA", "Fiscal Year", "Fiscal Week", "Fiscal Month"}),
				        #"Filtered Rows" = Table.SelectRows(#"Removed Other Columns", each [Date] >= #datetime(2021, 1, 1, 0, 0, 0)),
				        #"Added Custom Column" = Table.AddColumn(#"Filtered Rows", "ANNO_MESE_DESC", each let splitMESEDES = List.Reverse(Splitter.SplitTextByDelimiter(" ", QuoteStyle.None)([MESE_DES])) in Text.Combine({Text.Start([MESE_DES], 3), Text.Middle(splitMESEDES{0}?, 3, 1), " ", Text.Middle(Date.ToText(Date.From([ANNO_COD]), "yyyy"), 2)}), type text)
				in
				        #"Added Custom Column"

		annotation Description = "Import partition for Calendar dimension. Data filtered to dates >= 2021-01-01. Verify if full historical range is required. Proposed – pending Loro Piana validation on date range."

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

	annotation Description = "Date and time dimension table. Contains calendar attributes, fiscal periods, and pre-calculated date shifts for year-over-year and period comparisons. Grain: one row per calendar date. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Date, Calendar, Time, Fiscal Calendar"

	annotation DisplayFolder = "Time"

	annotation RefreshPolicy = "Weekly on Sundays at 00:00 UTC; data latency ≤ 48 hours. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana Data Governance Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-06 (pending business sign-off)."
