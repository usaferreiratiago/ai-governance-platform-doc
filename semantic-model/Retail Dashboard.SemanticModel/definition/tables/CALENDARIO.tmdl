	column YearMonthWeekFiscalCode = CALENDARIO[Fiscal Year] & "-" & RIGHT("0" & CALENDARIO[Fiscal Month],2) & "-" & RIGHT("0" & CALENDARIO[Fiscal Week],2)
		dataType: string
		lineageTag: 847680f6-bce8-4fde-a43c-0a64edb1dd07
		summarizeBy: none
		sortByColumn: YearMonthWeekFiscalSortOrder

		annotation SummarizationSetBy = Automatic

		annotation Description = "Fiscal year-month-week composite key (e.g., '2024-01-01'). Proposed – pending Loro Piana validation."

		annotation Synonyms = "Fiscal Period Code, YMW Code"

		annotation DisplayFolder = "Fiscal Calendar"

	column YearMonthWeekFiscalSortOrder = CALENDARIO[Date] - IF( CALENDARIO[DAY_OF_WEEK_COD] = "1" , 7, CALENDARIO[DAY_OF_WEEK_COD] -1 ) + 1
		dataType: dateTime
		formatString: General Date
		lineageTag: 4c2af4fe-411a-4ed8-93e8-6d3312d0fdba
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation Description = "Technical sort order for fiscal week combinations. Proposed – pending Loro Piana validation."

		annotation Synonyms = "Fiscal Sort Order"

		annotation DisplayFolder = "Fiscal Calendar"

	column YearMonthDayCode = CALENDARIO[ANNO_MESE_COD] & "-" & DAY(CALENDARIO[Date])
