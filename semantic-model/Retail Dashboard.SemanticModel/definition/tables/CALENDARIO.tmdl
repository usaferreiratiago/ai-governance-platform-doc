	column YearWeekFiscalCode = CALENDARIO[Fiscal Year] & "-" & RIGHT("0" & CALENDARIO[Fiscal Week],2)
		dataType: string
		lineageTag: 7be7f097-c8b4-4b82-ad57-9404a20f40e8
