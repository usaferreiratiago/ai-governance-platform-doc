	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

	annotation Description = "Selling logic dimension for the luxury retail assortment. Defines product classification logic used for sales strategy, merchandising decisions, and retail execution. Helps categorize products for sales planning, store allocation, and promotional strategies. Links to product-color variants to identify selling logic classifications. Grain: one row per selling logic code. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Selling Logic, Sales Logic, Merchandising Classification, Sales Strategy, Retail Category"

	annotation DisplayFolder = "Product Master"

	annotation RefreshPolicy = "Weekly on Sundays at 00:00 UTC; data latency ≤ 48 hours. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana Commercial Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "S01: Core Selling, S02: Seasonal, S03: Promotional, S04: Exclusive, S05: Capsule"

	annotation 'Common Questions' = "What are the selling logic classifications? How do selling logic categories differ? Which products follow each selling logic? How does selling logic influence sales and merchandising?"

	annotation 'Related Objects' = "ARTICOLI_COLORE.'Selling Logic Code', ARTICOLI, CLASSE_PRODOTTO, SCONTRINI, TARGET"
