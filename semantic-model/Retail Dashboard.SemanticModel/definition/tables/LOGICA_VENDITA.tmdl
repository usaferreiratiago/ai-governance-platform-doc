table LOGICA_VENDITA
	lineageTag: ea546b3c-e973-46e3-97fc-098ae28fac1f

	column SellingLogicCode
		dataType: string
		lineageTag: 9e657308-873a-42fa-9fb1-bdfab7466a12
		summarizeBy: none
		sourceColumn: Selling Logic Code

		annotation SummarizationSetBy = Automatic

		annotation Description = "Unique code identifying a selling logic classification (e.g., 'S01', 'S02', 'S03'). Used to link product-color variants to their selling logic category for sales strategy and merchandising. Proposed – pending Loro Piana validation."

		annotation Synonyms = "Selling Code, Sales Logic Code, Merchandising Code, Sales Category Code"

		annotation DisplayFolder = "Selling Logic Details"

		annotation 'Example Values' = "S01, S02, S03, S04, S05"

		annotation 'Common Questions' = "What is the selling logic code for Core Selling? How many products are in each selling logic? Which selling logic has the highest sales?"

		annotation 'Related Objects' = "ARTICOLI_COLORE.'Selling Logic Code'"

