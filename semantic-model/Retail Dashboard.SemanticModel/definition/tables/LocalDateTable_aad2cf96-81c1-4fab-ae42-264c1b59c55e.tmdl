	partition 'Local Date Table - Code Ago Date' = calculated
		mode: import
		source = Calendar(Date(Year(MIN('CALENDARIO'[COD_AGO_DTA])), 1, 1), Date(Year(MAX('CALENDARIO'[COD_AGO_DTA])), 12, 31))

		annotation Description = "Auto-generated local date table partition. Date range is dynamically calculated from the CALENDARIO table's COD_AGO_DTA (code ago date) column, spanning full years from the minimum to maximum ago-date year. This ensures the date table covers all ago-date references in the model. Proposed – pending Loro Piana validation on the business meaning and data source of COD_AGO_DTA."

	annotation __PBI_LocalDateTable = true

	annotation Description = "Power BI auto-generated local date table providing a continuous date range for time intelligence calculations based on the COD_AGO_DTA (code ago date) field from the CALENDARIO table. This hidden table serves as the foundation for date-based relationships and time intelligence functions that require a specific ago-date reference. Contains standard date attributes including Year, Quarter, Month, and Day, with a default 'Date Hierarchy' for drill-down analysis. Date range is dynamically derived from the 'CALENDARIO' table's COD_AGO_DTA column (full years only). Proposed – pending Loro Piana validation on the business meaning of COD_AGO_DTA."

	annotation Synonyms = "Local Date Table, Date Dimension, Time Dimension, Calendar Table, Date Hierarchy, Code Ago Date Table, Ago Date Reference"

