	partition 'Local Date Table - Sales Associate Summary' = calculated
		mode: import
		source = Calendar(Date(Year(MIN('SCONTRINI_SALES_ASS_TEMP'[Date])), 1, 1), Date(Year(MAX('SCONTRINI_SALES_ASS_TEMP'[Date])), 12, 31))

		annotation Description = "Auto-generated local date table partition. Date range is dynamically calculated from the SCONTRINI_SALES_ASS_TEMP table's Date column, spanning full years from the minimum to maximum year. This ensures the date table covers all sales associate summary dates referenced in the model. Used for associate performance analysis and daily metrics. Proposed – pending Loro Piana validation on data source and date range logic."

	annotation __PBI_LocalDateTable = true

	annotation Description = "Power BI auto-generated local date table providing a continuous date range for sales associate summary time intelligence calculations. This hidden table serves as the foundation for date-based relationships and time intelligence functions based on the Date field from the SCONTRINI_SALES_ASS_TEMP table. Contains standard date attributes including Year, Quarter, Month, and Day, with a default 'Date Hierarchy' for drill-down analysis. Date range is dynamically derived from the 'SCONTRINI_SALES_ASS_TEMP' table's Date column (full years only). Used for sales associate performance analysis, daily metrics, and associate-level reporting. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Local Date Table, Date Dimension, Time Dimension, Calendar Table, Date Hierarchy, Sales Associate Date Table, Associate Performance Date Table"

	annotation DisplayFolder = "System Tables"

	annotation RefreshPolicy = "Dynamically generated based on SCONTRINI_SALES_ASS_TEMP table data range. No manual refresh required. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana BI Team. Proposed – pending validation."

