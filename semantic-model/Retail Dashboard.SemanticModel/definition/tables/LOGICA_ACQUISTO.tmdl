		lineageTag: c7152770-f724-4268-bfe5-1ff3600b6653
		summarizeBy: none
		sourceColumn: Buying Logic Code

		annotation SummarizationSetBy = Automatic

		annotation Description = "Unique code identifying a buying logic classification (e.g., 'B01', 'B02', 'B03'). Used to link product-color variants to their buying logic category. Proposed – pending Loro Piana validation."

