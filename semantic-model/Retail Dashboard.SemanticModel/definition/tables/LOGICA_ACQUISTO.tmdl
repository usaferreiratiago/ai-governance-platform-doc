	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

	annotation Description = "Buying logic dimension for the luxury retail assortment. Defines product classification logic used for purchasing and procurement decisions. Helps categorize products for buying strategies, vendor negotiations, and assortment planning. Links to product-color variants to identify buying logic classifications. Grain: one row per buying logic code. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Buying Logic, Purchase Logic, Procurement Classification, Buying Strategy, Purchasing Category"

	annotation DisplayFolder = "Product Master"

	annotation RefreshPolicy = "Weekly on Sundays at 00:00 UTC; data latency ≤ 48 hours. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana Buying Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "B01: Core Collection, B02: Seasonal, B03: Capsule, B04: Basic, B05: Exclusive"

	annotation 'Common Questions' = "What are the buying logic classifications? How do buying logic categories differ? Which products follow each buying logic? How does buying logic influence procurement decisions?"

	annotation 'Related Objects' = "ARTICOLI_COLORE.'Buying Logic Code', ARTICOLI, CLASSE_PRODOTTO, SCONTRINI"
