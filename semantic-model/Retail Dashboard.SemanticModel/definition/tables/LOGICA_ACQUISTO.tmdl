		annotation DisplayFolder = "Buying Logic Details"

		annotation 'Example Values' = "B01, B02, B03, B04, B05"

		annotation 'Common Questions' = "What is the buying logic code for Core Collection? How many products are in each buying logic? Which buying logic has the highest purchase volume?"

		annotation 'Related Objects' = "ARTICOLI_COLORE.'Buying Logic Code'"

