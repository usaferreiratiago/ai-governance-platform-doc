	partition 'Time Period Selection' = calculated
		mode: import
		source =
				{
				    ("WEEK_COD", NAMEOF('CALENDARIO'[WEEK_COD]), 0),
				    ("Day", NAMEOF('CALENDARIO'[Date]), 1)
				}

		annotation Description = "Calculated partition that unions two time granularity options from the CALENDARIO table: WEEK_COD (weekly granularity) and Date (daily granularity). This creates a unified selection dimension for switching between day and week levels in reports. Sort order: WEEK_COD (0) then Day (1)."

	annotation PBI_Id = 5fcb19b336b548ac9cc3f627eb97c43f

	annotation Description = "Time period selection dimension for dynamic time granularity switching in reports. Provides a user-selectable list of time granularities (e.g., Day, Week) for toggling between different levels of temporal detail. Enables users to switch between daily and weekly views in visuals without rebuilding reports. Grain: one row per time granularity option. Proposed – pending Loro Piana validation."

	annotation Synonyms = "Time Selector, Time Granularity Selector, Time Period Picker, Temporal Granularity, Date Level Selector"

	annotation DisplayFolder = "Parameters"

	annotation RefreshPolicy = "Static hardcoded list. No refresh required. Proposed – pending Loro Piana validation."

	annotation BusinessOwner = "Loro Piana BI Team. Proposed – pending validation."

	annotation CertificationStatus = "Certified by BI Team on 2026-08-07 (pending business sign-off)."

	annotation 'Example Values' = "Day (Daily granularity), Week (Weekly granularity)"

	annotation 'Common Questions' = "How do I switch between day and week views? What time granularities are available for selection? How do I change from daily to weekly reporting? What is the difference between Day and Week views?"

	annotation 'Related Objects' = "CALENDARIO, SCONTRINI, TARGET, DateTableTemplate"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
